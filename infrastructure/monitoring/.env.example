# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-production
GRAFANA_ROOT_URL=https://grafana.example.com

# Prometheus
PROMETHEUS_RETENTION=15d

# Alertmanager SMTP
ALERTMANAGER_SMTP_HOST=smtp.example.com
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_FROM=alerts@example.com
ALERTMANAGER_SMTP_USERNAME=
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_EMAIL_TO=ops@example.com
ALERTMANAGER_CRITICAL_EMAIL_TO=oncall@example.com

# Host service ports used by exporters
POSTGRES_PORT=5433
POSTGRES_USER=artisan
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_DB=artisanos
REDIS_PORT=6379
