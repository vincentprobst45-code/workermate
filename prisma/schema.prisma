generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String    @id @default(uuid())
  name      String

  addressId String?
  address   Address?  @relation("TenantMainAddress",fields: [addressId], references: [id], onDelete: Cascade)

  email String?
  phoneNumber String?

  siretNumber String?
  vatNumber String?

  iban String?
  bic String?

  invoiceNumberPrefix String @default("FAC")
  nextInvoiceNumber Int @default(1)
  invoiceNumberYear   Int

  quoteNumberPrefix String @default("DEV")
  nextQuoteNumber Int @default(1)
  quoteNumberYear   Int
  

  logoFileId String?

  defaultCurrency String @default("EUR")

  defaultPaymentTerms String?
  defaultLegalMentions String?
  defaultInvoiceNotes String?

  defaultVatRate Decimal?

  createdAt DateTime  @default(now())

  memberships Membership[]
  addresses Address[] @relation("TenantAddresses")
  customers   Customer[]
  quotes    Quote[]
  workOrders    WorkOrder[]
  invoices    Invoice[]
  calendarevents CalendarEvent[]
  catalogItems CatalogItem[]
  projects Project[]
}

model User {
  id         String       @id @default(uuid())
  email      String       @unique
  password   String
  firstname  String?
  lastname   String?
  activeTenantId String?

  addressId String?
  address   Address?  @relation(fields: [addressId], references: [id], onDelete: Cascade)

  createdAt  DateTime     @default(now())

  memberships Membership[]
  createdCustomers Customer[] @relation("CustomerCreator")
  createdWorkOrders    WorkOrder[] @relation("WorkOrderCreator")
  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreator")
}

model Membership {
  userId   String
  tenantId String
  role     TenantRole
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([userId, tenantId])
}

model Address {
  id String @id @default(cuid())

  tenantId String
  tenant Tenant @relation("TenantAddresses", fields: [tenantId], references: [id], onDelete: Cascade)

  // Adresse
  street1 String
  street2 String?

  postalCode String
  city       String
  region     String?
  countryCode String @default("FR")

  // Coordonnées GPS (optionnel)
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // Informations complémentaires
  accessCode String?
  floor      String?
  apartment  String?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  quotes Quote[]
  customers Customer[]
  workOrders WorkOrder[]
  tenants Tenant[] @relation("TenantMainAddress")
  users User[]
  calendarevents CalendarEvent[]
}

model Customer {
  id        String   @id @default(uuid())

  // Relation
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User? @relation("CustomerCreator", fields: [createdById], references: [id])

  // Identité
  firstName String?
  lastName  String?
  company   String?

  // Contact
  email     String?
  phone     String?
  mobile    String?


  // Addresse de facturation
  addressId String?
  address   Address?  @relation(fields: [addressId], references: [id], onDelete: Cascade)


  // Professionnels
  siret     String?
  vatNumber String?

  // Divers
  notes     String?

  // Relations
  quotes    Quote[]
  workOrders    WorkOrder[]
  calendarevents CalendarEvent[]
  invoices Invoice[]
  projects ProjectCustomer[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([tenantId])
  @@index([lastName])
  @@index([company])
}

model CalendarEvent {
  id          String   @id @default(cuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  addressId   String?
  address     Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)

  workOrderId   String?
  workOrder     WorkOrder?  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User? @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title       String
  description String?

  startDate   DateTime
  endDate     DateTime
  
  allDay Boolean @default(false)
  status CalendarEventStatus @default(SCHEDULED)

  color     String?

  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

}

model WorkOrder {
  id          String   @id @default(cuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User? @relation("WorkOrderCreator", fields: [createdById], references: [id])

  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  addressId   String?
  address     Address?  @relation(fields: [addressId], references: [id])

  projectId String?
  project Project? @relation(fields: [projectId], references: [id])

  reference   String   @unique

  title       String
  description String?

  status      WorkOrderStatus @default(DRAFT)

  startDate   DateTime?
  endDate     DateTime?

  estimatedDuration Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  items WorkOrderItem[]
  quotes    Quote[]
  documents Document[]
  calendarevents CalendarEvent[]
  invoices Invoice[]

  @@index([tenantId])
  @@index([customerId])
}

model WorkOrderItem {

  id String @id @default(cuid())

  workOrderId String
  workOrder WorkOrder @relation(fields:[workOrderId], references:[id], onDelete:Cascade)

  type WorkOrderItemType

  position Int

  title String

  description String?

  quantity Decimal @db.Decimal(10,2) @default(1)

  unit String?

  unitPrice Decimal @db.Decimal(10,2)

  vatRate Decimal @db.Decimal(4,2)

  @@index([workOrderId])
}

model Document {

  id String @id @default(cuid())

  workOrderId String
  workOrder WorkOrder @relation(fields:[workOrderId], references:[id], onDelete:Cascade)

  type DocumentType

  reference String @unique

  status DocumentStatus

  issuedAt DateTime?

  dueAt DateTime?

  notes String?

  createdAt DateTime @default(now())

  items DocumentItem[]
}

model DocumentItem {

  id String @id @default(cuid())

  documentId String
  document Document @relation(fields:[documentId], references:[id], onDelete:Cascade)

  position Int

  type WorkOrderItemType

  title String

  description String?

  quantity Decimal @db.Decimal(10,2)

  unit String?

  unitPrice Decimal @db.Decimal(10,2)

  vatRate Decimal @db.Decimal(4,2)
}

model Invoice {
  id String @id @default(cuid())

  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])

  customerId String
  customer Customer @relation(fields: [customerId], references: [id])

  workOrderId String?
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  projectId String?
  project Project? @relation(fields: [projectId], references: [id])

  number String @unique
  
  issueDate DateTime
  dueDate DateTime?
  workOrderReference String
  workOrderTitle String

  tenantName String
  tenantStreet1 String
  tenantStreet2 String?
  tenantPostalCode String
  tenantCity String
  tenantSiretNumber String
  tenantVatNumber String
  tenantEmail String
  tenantPhoneNumber String
  
  tenantIban String?
  tenantBic String?

  customerFirstName String
  customerLastName String
  customerStreet1 String
  customerStreet2 String?
  customerPostalCode String
  customerCity String
  customerEmail String?
  customerPhoneNumber String?
  customerVatNumber String?

  workOrderStartDate DateTime?
  workOrderEndDate DateTime?
  workOrderAddress String?
  workOrderPostalCode String?
  workOrderCity String?

  status InvoiceStatus @default(DRAFT)

  currency String @default("EUR")

  subtotal Decimal @db.Decimal(12,2)
  vatAmount Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)

  paymentTerms String?
  legalMentions String?
  notes String?

  depositAmount Decimal?
  discountAmount Decimal?
  
  paidAt DateTime?
  paymentMethod PaymentMethod?

  pdfFileId String?

  pdpStatus InvoicePdpStatus @default(NOT_SENT)
  pdpMessageId String?

  //Devis
  quoteId String?
  quoteNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InvoiceItem[]
}

model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type WorkOrderItemType

  position Int

  title String

  description String

  quantity Decimal @db.Decimal(10,2)

  unit String?

  unitPrice Decimal @db.Decimal(12,2)

  vatRate Decimal @db.Decimal(5,2)

  total Decimal @db.Decimal(12,2)

  @@index([invoiceId])
}

model Quote {
  id String @id @default(cuid())

  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])

  customerId String
  customer Customer @relation(fields: [customerId], references: [id])

  workOrderId String?
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  projectId String?
  project Project? @relation(fields: [projectId], references: [id])

  title String

  number String @unique

  issueDate DateTime
  validUntil DateTime?

  workOrderReference String?
  workOrderTitle String?

  // Coordonnées de l'entreprise (snapshot)
  tenantName String
  tenantStreet1 String
  tenantStreet2 String?
  tenantPostalCode String
  tenantCity String
  tenantSiretNumber String
  tenantVatNumber String
  tenantEmail String
  tenantPhoneNumber String
  tenantIban String?
  tenantBic String?

  // Coordonnées du client (snapshot)
  customerFirstName String
  customerLastName String
  customerStreet1 String
  customerStreet2 String?
  customerPostalCode String
  customerCity String
  customerEmail String?
  customerPhoneNumber String?
  customerVatNumber String?

  // Adresse du chantier
  workOrderStartDate DateTime?
  workOrderEndDate DateTime?

  workOrderaddressId   String?
  workOrderAddress     Address?  @relation(fields: [workOrderaddressId], references: [id])

  status QuoteStatus @default(DRAFT)

  currency String @default("EUR")

  subtotal Decimal @db.Decimal(12,2)
  vatAmount Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)

  paymentTerms String?
  legalMentions String?
  notes String?

  depositAmount Decimal?

  pdfFileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]
}

model QuoteItem {
  id String @id @default(cuid())

  quoteId String
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  type WorkOrderItemType

  position Int

  title String

  description String

  quantity Decimal @db.Decimal(10,2)

  unit String?

  unitPrice Decimal @db.Decimal(12,2)

  vatRate Decimal @db.Decimal(5,2)

  total Decimal @db.Decimal(12,2)

  @@index([quoteId])
}

model CatalogItem {
  id String @id @default(cuid())

  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])

  type WorkOrderItemType

  title String

  description String?

  defaultQuantity Decimal @db.Decimal(10,2) @default(1)

  unit String?

  unitPrice Decimal @db.Decimal(12,2)

  vatRate Decimal @db.Decimal(5,2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Project {
  id String @id @default(cuid())

  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])

  reference String
  title String
  description String?
  status ProjectStatus @default(OPEN)
  notes String?

  customers ProjectCustomer[]

  quotes Quote[]
  workOrders WorkOrder[]
  invoices Invoice[]
  calendarEvents CalendarEvent[]

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, reference])
  @@index([tenantId])
}

model ProjectCustomer {
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@id([projectId, customerId])
  @@index([customerId])
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderItemType {
  LABOR
  MATERIAL
  EQUIPMENT
  TRAVEL
  SERVICE
  OTHER

}

enum DocumentType {
  ESTIMATE
  INVOICE
  OTHER
}

enum DocumentStatus {
  NOTREADY
  READY
  SENT
  VALIDATED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  CHECK
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum InvoicePdpStatus {
    NOT_SENT
    SENT
    ACCEPTED
    REJECTED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}