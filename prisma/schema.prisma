model CatalogItem {
  id String @id @default(cuid())

  tenantId String
  tenant Tenant @relation(fields: [tenantId],references: [id],onDelete: Cascade)

  // ==========================================================================
  // IDENTIFICATION
  // ==========================================================================

  type LineItemType

  // Référence interne de l'article/prestation.
  //
  // Exemple :
  // MAT-CUIVRE-22
  // MO-PLOMBERIE
  // DEP-001
  //
  // Peut être copiée dans sellerItemIdentifier
  // sur QuoteItem / InvoiceItem.
  reference String?

  title String
  description String?

  // Permet de désactiver une entrée sans la supprimer,
  // afin de préserver l'historique.
  isActive Boolean @default(true)


  // ==========================================================================
  // QUANTITÉ / UNITÉ PAR DÉFAUT
  // ==========================================================================

  // Quantité proposée par défaut à l'ajout dans un devis/WorkOrder.
  //
  // Plus de 2 décimales pour :
  // 0.125 m³
  // 1.333 heure
  // etc.
  defaultQuantity Decimal @default(1) @db.Decimal(19, 6)

  // Code d'unité normalisé.
  //
  // Peut être copié directement vers :
  // QuoteItem.unitCode
  // InvoiceItem.unitCode -> FE BT-130
  //
  // Exemples :
  // C62 = unité
  // HUR = heure
  // KGM = kilogramme
  // MTR = mètre
  unitCode String

  // Libellé humain utilisé dans l'interface.
  //
  // "unité", "heure", "kg", "m"...
  unitLabel String?


  // ==========================================================================
  // PRIX DE VENTE
  // ==========================================================================

  // Prix unitaire de vente NET HT par défaut.
  //
  // Peut être copié vers :
  // QuoteItem.unitPrice
  // InvoiceItem.unitPrice -> FE BT-146
  unitPrice Decimal @db.Decimal(19, 6)

  // Quantité de base à laquelle le prix correspond.
  //
  // Exemple :
  // 25 € pour 100 vis
  //
  // unitPrice = 25
  // baseQuantity = 100
  //
  // Peut devenir InvoiceItem.baseQuantity -> FE BT-149.
  baseQuantity Decimal @default(1) @db.Decimal(19, 6)

  // Code unité correspondant à baseQuantity.
  // Peut devenir InvoiceItem.baseQuantityUnitCode -> FE BT-150.
  baseQuantityUnitCode String?


  // ==========================================================================
  // TVA DE VENTE
  // ==========================================================================

  // Catégorie TVA proposée par défaut.
  //
  // Peut être copiée dans QuoteItem / InvoiceItem.
  //
  // STANDARD
  // EXEMPT
  // REVERSE_CHARGE
  // INTRA_COMMUNITY_SUPPLY
  // EXPORT
  // OUTSIDE_SCOPE
  // ZERO
  vatCategory VatCategory @default(STANDARD)

  // Taux de TVA proposé par défaut.
  //
  // Nullable car certaines catégories TVA ne correspondent pas
  // à un taux classique.
  vatRate Decimal? @db.Decimal(5, 2)


  // ==========================================================================
  // COÛT / RENTABILITÉ
  // ==========================================================================

  // Coût unitaire HT estimé.
  //
  // Sert au budget prévisionnel / calcul de marge.
  // Ne doit jamais être copié sur une facture client.
  unitCost Decimal? @db.Decimal(19, 6)

  // TVA d'achat indicative.
  //
  // Sert éventuellement aux estimations de trésorerie/achat.
  // Elle ne constitue pas la TVA réellement constatée :
  // celle-ci devra venir d'une future facture fournisseur / PurchaseItem.
  purchaseVatRate Decimal? @db.Decimal(5, 2)


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, reference])

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Project {
  id String @id @default(cuid())

  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])

  reference String
  title String
  description String?
