enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Purchase {
  id String @id @default(cuid())

  // ==========================================================================
  // PROPRIÉTAIRE
  // ==========================================================================

  tenantId String
  tenant Tenant @relation(fields: [tenantId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // FOURNISSEUR — FACULTATIF
  // ==========================================================================

  // L'utilisateur peut enregistrer un achat sans créer de Supplier.
  supplierId String?

  supplier Supplier? @relation(fields: [supplierId],references: [id],onDelete: SetNull)

  // Permet éventuellement de simplement saisir :
  // "Point.P", "Leroy Merlin", etc.
  //
  // Si supplierId est renseigné, le backend peut automatiquement
  // renseigner cette valeur à partir du Supplier.
  supplierName String?


  // ==========================================================================
  // IDENTIFICATION
  // ==========================================================================

  // Libellé libre facultatif :
  // "Matériaux chantier Dupont"
  // "Achat électricité"
  label String?

  purchaseDate DateTime @db.Date

  status PurchaseStatus @default(CONFIRMED)

  currency String @default("EUR")


  // ==========================================================================
  // MONTANTS
  // ==========================================================================

  // Totaux opérationnels calculés depuis les PurchaseItem.
  //
  // Ils peuvent servir à la trésorerie tant qu'aucune véritable
  // SupplierInvoice n'a pris le relais comme source financière/fiscale.

  taxExclusiveAmount Decimal? @db.Decimal(19, 2)

  vatAmount Decimal? @db.Decimal(19, 2)

  taxInclusiveAmount Decimal @db.Decimal(19, 2)

  // TVA considérée comme récupérable au moment de l'achat.
  //
  // Cette valeur reste opérationnelle/prévisionnelle.
  // Si l'achat est ensuite rapproché d'une SupplierInvoice,
  // la SupplierInvoice devient la source fiscale de vérité.
  deductibleVatAmount Decimal? @db.Decimal(19, 2)

  // Coût économique réel de l'achat :
  //
  // TTC - TVA déductible
  //
  // Exemple :
  // 120 € TTC avec 20 € entièrement déductibles -> 100 €
  // 120 € TTC sans droit à déduction            -> 120 €
  effectiveCostAmount Decimal @db.Decimal(19, 2)


  // ==========================================================================
  // TRÉSORERIE
  // ==========================================================================

  // Pour un achat payé immédiatement.
  paidAt DateTime?

  // Pour un achat enregistré avant son paiement.
  dueDate DateTime?

  paymentAccountId String?

  paymentAccount PaymentAccount? @relation(fields: [paymentAccountId],references: [id],onDelete: SetNull)

  // Rapprochement bancaire facultatif.
  //
  // Suffisant pour la V1.
  // Si plus tard un Purchase peut être payé par plusieurs transactions,
  // on remplacera cette relation par un modèle d'allocation.
  bankTransactionId String?

  bankTransaction BankTransaction? @relation(fields: [bankTransactionId],references: [id],onDelete: SetNull)


  // ==========================================================================
  // CONTENU
  // ==========================================================================

  items PurchaseItem[]


  // ==========================================================================
  // AUTRES
  // ==========================================================================

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================================
  // INDEXES
  // ==========================================================================

  @@index([tenantId, purchaseDate])
  @@index([tenantId, status])
  @@index([supplierId])
  @@index([paymentAccountId])
  @@index([bankTransactionId])
}

model PurchaseItem {
  id String @id @default(cuid())

  purchaseId String

  purchase Purchase @relation(fields: [purchaseId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // IDENTIFICATION
  // ==========================================================================

  position Int

  // Article du catalogue correspondant à ce qui a été acheté.
  //
  // Facultatif car on peut enregistrer :
  // - une prestation,
  // - un achat libre,
  // - quelque chose qui ne doit pas entrer dans le catalogue.
  //
  // Pour un article ajouté au stock, CatalogItem est en revanche requis
  // au niveau métier.
  catalogItemId String?

  catalogItem CatalogItem? @relation(fields: [catalogItemId],references: [id],onDelete: SetNull)

  type LineItemType

  // Snapshot : ne dépend pas d'une modification future du CatalogItem.
  title String
  description String?


  // ==========================================================================
  // QUANTITÉ / UNITÉ
  // ==========================================================================

  quantity Decimal @default(1) @db.Decimal(19, 6)

  // C62, HUR, KGM, MTR...
  unitCode String

  // unité, heure, kg, m...
  unitLabel String?

  // Permet par exemple :
  // prix de 200 € pour 100 unités.
  baseQuantity Decimal @default(1) @db.Decimal(19, 6)

  baseQuantityUnitCode String?


  // ==========================================================================
  // PRIX FOURNISSEUR
  // ==========================================================================

  // Prix unitaire HT porté/connu lors de l'achat.
  //
  // Nullable car l'utilisateur peut simplement saisir :
  // "100 m pour 480 € TTC"
  // sans connaître immédiatement le HT.
  unitPrice Decimal? @db.Decimal(19, 6)

  // Montant HT total de la ligne.
  taxExclusiveAmount Decimal? @db.Decimal(19, 2)


  // ==========================================================================
  // TVA D'ACHAT
  // ==========================================================================

  vatRate Decimal? @db.Decimal(5, 2)

  // TVA facturée sur cette ligne.
  vatAmount Decimal? @db.Decimal(19, 2)

  // Partie de vatAmount réellement récupérable.
  //
  // Exemple :
  //
  // vatAmount             = 20 €
  // deductibleVatAmount   = 20 € -> coût économique = 100 €
  //
  // ou :
  //
  // vatAmount             = 20 €
  // deductibleVatAmount   = 0 €  -> coût économique = 120 €
  deductibleVatAmount Decimal? @db.Decimal(19, 2)

  // Montant réellement payé / dû au fournisseur pour cette ligne.
  taxInclusiveAmount Decimal @db.Decimal(19, 2)


  // ==========================================================================
  // COÛT ÉCONOMIQUE / STOCK
  // ==========================================================================

  // Coût qui doit réellement être imputé au stock et aux chantiers.
  //
  // Il exclut la TVA récupérable mais inclut la TVA non récupérable :
  //
  // effectiveCostAmount =
  // taxInclusiveAmount - deductibleVatAmount
  //
  // Exemple artisan assujetti :
  // 100 HT + 20 TVA déductible
  // -> effectiveCostAmount = 100
  //
  // Exemple franchise en base :
  // 100 HT + 20 TVA non déductible
  // -> effectiveCostAmount = 120
  effectiveCostAmount Decimal @db.Decimal(19, 2)

  // Coût économique rapporté à baseQuantity.
  //
  // C'est ce coût qui alimente le StockItem.averageUnitCost.
  effectiveUnitCost Decimal @db.Decimal(19, 6)


  // ==========================================================================
  // AFFECTATION MÉTIER FACULTATIVE
  // ==========================================================================

  // Permet de savoir dès l'achat que celui-ci concerne un projet,
  // sans pour autant considérer que tout le matériel est déjà consommé
  // par le projet.
  projectId String?

  project Project? @relation(fields: [projectId],references: [id],onDelete: SetNull)

  workOrderId String?

  workOrder WorkOrder? @relation(fields: [workOrderId],references: [id],onDelete: SetNull)


  // ==========================================================================
  // STOCK
  // ==========================================================================

  // Un PurchaseItem peut produire plusieurs mouvements dans le futur :
  // achat initial, correction, annulation partielle...
  stockMovements StockMovement[]


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================================
  // CONTRAINTES
  // ==========================================================================

  @@unique([purchaseId, position])

  @@index([purchaseId])
  @@index([catalogItemId])
  @@index([projectId])
  @@index([workOrderId])
}

// ============================================================================
// SUPPLIER INVOICE ENUMS
// ============================================================================

enum SupplierInvoiceKind {
  INVOICE
  CREDIT_NOTE
}

enum SupplierInvoiceStatus {
  // Document en cours de saisie / vérification.
  // Ne doit pas encore être utilisé comme source financière/fiscale définitive.
  DRAFT

  // Document vérifié et validé dans Workermate.
  CONFIRMED

  // Document annulé / invalidé dans Workermate.
  CANCELLED
}

enum SupplierInvoiceSettlementStatus {
  UNSETTLED
  PARTIALLY_SETTLED
  SETTLED
}


// ============================================================================
// SUPPLIER
// ============================================================================

model Supplier {
  id String @id @default(cuid())


  // ==========================================================================
  // PROPRIÉTAIRE
  // ==========================================================================

  tenantId String

  tenant Tenant @relation(fields: [tenantId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // IDENTIFICATION
  // ==========================================================================

  // Référence interne facultative :
  // "POINTP", "REXEL", "FOURN-001"...
  reference String?

  // Nom affiché dans Workermate :
  // "Point.P Orléans", "Rexel", etc.
  name String

  // Raison sociale officielle si différente du nom affiché.
  legalName String?


  // ==========================================================================
  // IDENTIFIANTS LÉGAUX
  // ==========================================================================

  sirenNumber String?
  siretNumber String?

  vatNumber String?


  // ==========================================================================
  // CONTACT
  // ==========================================================================

  contactName String?

  email String?
  phone String?

  website String?


  // ==========================================================================
  // ADRESSE
  // ==========================================================================

  // Je préfère ici conserver une adresse simple directement sur Supplier.
  // SupplierInvoice en prendra ensuite un snapshot.
  //
  // On pourra toujours normaliser davantage plus tard si nécessaire.

  street1 String?
  street2 String?

  postalCode String?
  city String?

  countryCode String @default("FR")


  // ==========================================================================
  // AUTRES
  // ==========================================================================

  notes String?

  purchases Purchase[]

  invoices SupplierInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // On archive un fournisseur utilisé historiquement au lieu de le supprimer.
  archivedAt DateTime?


  // ==========================================================================
  // CONTRAINTES / INDEXES
  // ==========================================================================

  @@unique([tenantId, reference])

  // Évite notamment de créer plusieurs fois le même établissement
  // lorsque son SIRET est connu.
  //
  // PostgreSQL accepte plusieurs NULL dans cette contrainte.
  @@unique([tenantId, siretNumber])

  @@index([tenantId, name])
  @@index([tenantId, archivedAt])
}


// ============================================================================
// SUPPLIER INVOICE
// ============================================================================

model SupplierInvoice {
  id String @id @default(cuid())


  // ==========================================================================
  // PROPRIÉTAIRE
  // ==========================================================================

  tenantId String

  tenant Tenant @relation(fields: [tenantId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // FOURNISSEUR
  // ==========================================================================

  // Contrairement à Purchase, une véritable facture fournisseur
  // doit être rattachée à un fournisseur identifié.

  supplierId String

  supplier Supplier @relation(fields: [supplierId],references: [id],onDelete: Restrict)


  // ==========================================================================
  // DOCUMENT
  // ==========================================================================

  kind SupplierInvoiceKind @default(INVOICE)

  status SupplierInvoiceStatus @default(DRAFT)

  // Numéro attribué par le fournisseur.
  supplierInvoiceNumber String

  issueDate DateTime @db.Date

  // Date à laquelle l'entreprise a effectivement reçu le document.
  receivedDate DateTime? @db.Date

  dueDate DateTime? @db.Date

  currency String @default("EUR")


  // ==========================================================================
  // SNAPSHOT FOURNISSEUR
  // ==========================================================================

  // Ces valeurs sont copiées depuis Supplier lorsque le document
  // devient CONFIRMED.
  //
  // Elles permettent de conserver l'historique même si la fiche
  // fournisseur est modifiée plusieurs années plus tard.

  supplierName String
  supplierLegalName String?

  supplierSirenNumber String?
  supplierSiretNumber String?
  supplierVatNumber String?

  supplierEmail String?

  supplierStreet1 String?
  supplierStreet2 String?

  supplierPostalCode String?
  supplierCity String?

  supplierCountryCode String @default("FR")


  // ==========================================================================
  // TOTAUX DU DOCUMENT
  // ==========================================================================

  // Somme nette des lignes avant éventuelles remises/frais globaux.
  //
  // Nullable car Workermate doit pouvoir enregistrer une facture
  // fournisseur uniquement à partir de ses totaux, sans recopier
  // toutes ses lignes.
  lineNetTotal Decimal? @db.Decimal(19, 2)

  // Remises globales présentes sur le document.
  allowanceTotal Decimal @default(0) @db.Decimal(19, 2)

  // Frais globaux présents sur le document :
  // transport, emballage, etc.
  chargeTotal Decimal @default(0) @db.Decimal(19, 2)

  // Total HT du document.
  taxExclusiveAmount Decimal @db.Decimal(19, 2)

  // TVA portée par le document.
  vatAmount Decimal @default(0) @db.Decimal(19, 2)

  // Total TTC du document.
  taxInclusiveAmount Decimal @db.Decimal(19, 2)


  // ==========================================================================
  // TVA DÉDUCTIBLE
  // ==========================================================================

  // Partie de la TVA que l'entreprise est effectivement en droit
  // de récupérer.
  //
  // Ce montant peut être différent de vatAmount.
  //
  // Exemple :
  //
  // TVA facturée          100 €
  // TVA déductible         80 €
  //
  // Les 20 € restants font partie du coût économique réel.
  deductibleVatAmount Decimal @default(0) @db.Decimal(19, 2)


  // ==========================================================================
  // RÈGLEMENT
  // ==========================================================================

  // On utilise "settlement" plutôt que "payment" pour que la logique
  // reste correcte aussi pour les avoirs fournisseur.

  settledAmount Decimal @default(0) @db.Decimal(19, 2)

  // Montant restant à régler / solder.
  //
  // Pour une facture :
  // taxInclusiveAmount - settledAmount
  //
  // Les montants restent positifs.
  // Le signe financier dépend de SupplierInvoiceKind.
  openAmount Decimal @db.Decimal(19, 2)

  settlementStatus SupplierInvoiceSettlementStatus @default(UNSETTLED)


  // ==========================================================================
  // CONTENU
  // ==========================================================================

  // Facultatif dans les faits :
  // une SupplierInvoice peut être parfaitement valide avec items = []
  // si l'utilisateur saisit uniquement les totaux.
  items SupplierInvoiceItem[]


  // ==========================================================================
  // NOTES
  // ==========================================================================

  // Information éventuellement présente sur le document.
  notes String?

  // Information Workermate qui ne fait pas partie du document.
  internalNotes String?


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================================
  // CONTRAINTES / INDEXES
  // ==========================================================================

  // Évite d'importer deux fois la même facture du même fournisseur.
  @@unique([tenantId, supplierId, supplierInvoiceNumber])

  @@index([tenantId, issueDate])
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
  @@index([tenantId, settlementStatus])

  @@index([supplierId, issueDate])
}


// ============================================================================
// SUPPLIER INVOICE ITEM
// ============================================================================

model SupplierInvoiceItem {
  id String @id @default(cuid())

  supplierInvoiceId String

  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // IDENTIFICATION
  // ==========================================================================

  position Int

  // Identifiant porté par le document électronique fournisseur,
  // lorsqu'il existe.
  lineIdentifier String?

  notes String[] @default([])

  // La classification MATERIAL / SERVICE / etc. n'est pas obligatoire
  // pour une facture fournisseur.
  //
  // Workermate doit pouvoir importer le document sans demander à
  // l'artisan de classifier chaque ligne.
  type LineItemType?

  title String
  description String?

  // Référence article utilisée par le fournisseur.
  sellerItemIdentifier String?


  // ==========================================================================
  // QUANTITÉ / UNITÉ
  // ==========================================================================

  quantity Decimal @default(1) @db.Decimal(19, 6)

  // Peut être inconnu lors d'une saisie manuelle ou d'un OCR.
  //
  // Exemple :
  // C62, HUR, KGM, MTR...
  unitCode String?

  unitLabel String?

  // Quantité sur laquelle porte unitPrice.
  baseQuantity Decimal @default(1) @db.Decimal(19, 6)

  baseQuantityUnitCode String?


  // ==========================================================================
  // PRIX
  // ==========================================================================

  // Prix unitaire HT lorsqu'il est disponible.
  //
  // Nullable pour permettre une ligne saisie simplement comme :
  // "Matériaux divers : 850 € HT".
  unitPrice Decimal? @db.Decimal(19, 6)

  // Montant net HT réel de la ligne.
  taxExclusiveAmount Decimal @db.Decimal(19, 2)


  // ==========================================================================
  // TVA
  // ==========================================================================

  vatCategory VatCategory @default(STANDARD)

  vatRate Decimal? @db.Decimal(5, 2)

  // TVA réellement portée par cette ligne.
  vatAmount Decimal @default(0) @db.Decimal(19, 2)

  // TVA de cette ligne réellement récupérable par l'entreprise.
  //
  // C'est cette donnée qui permettra ensuite à Workermate
  // de calculer correctement la TVA déductible.
  deductibleVatAmount Decimal @default(0) @db.Decimal(19, 2)

  vatExemptionReason String?
  vatExemptionReasonCode String?

  // Montant TTC de la ligne.
  taxInclusiveAmount Decimal @db.Decimal(19, 2)


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================================
  // CONTRAINTES / INDEXES
  // ==========================================================================

  @@unique([supplierInvoiceId, position])

  // PostgreSQL autorise plusieurs lineIdentifier NULL.
  @@unique([supplierInvoiceId, lineIdentifier])

  @@index([supplierInvoiceId])
}

// ============================================================================
// STOCK MOVEMENT ENUMS
// ============================================================================

enum StockMovementDirection {
  IN
  OUT
}

enum StockMovementReason {
  // Stock renseigné lors de l'initialisation de Workermate.
  OPENING_BALANCE

  // Entrée provenant d'un PurchaseItem.
  PURCHASE

  // Sortie correspondant à une consommation réelle enregistrée
  // dans un WorkLogItem.
  CONSUMPTION

  // Matériel retourné au fournisseur.
  SUPPLIER_RETURN

  // Matériel précédemment sorti puis remis en stock.
  //
  // Exemple :
  // 30 m sortis pour un chantier,
  // finalement 5 m non utilisés sont remis en stock.
  RETURN_TO_STOCK

  // Correction manuelle / inventaire.
  //
  // Le sens est donné par direction :
  // IN  = ajout
  // OUT = retrait
  ADJUSTMENT

  // Annulation logique d'un mouvement précédent.
  //
  // Le sens est nécessairement opposé au mouvement annulé.
  REVERSAL
}


// ============================================================================
// STOCK MOVEMENT
// ============================================================================

model StockMovement {
  id String @id @default(cuid())


  // ==========================================================================
  // PROPRIÉTAIRE
  // ==========================================================================

  tenantId String

  tenant Tenant @relation(fields: [tenantId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // STOCK
  // ==========================================================================

  stockItemId String

  stockItem StockItem @relation(fields: [stockItemId],references: [id],onDelete: Restrict)


  // ==========================================================================
  // MOUVEMENT
  // ==========================================================================

  // IN  = entrée dans le stock
  // OUT = sortie du stock
  direction StockMovementDirection

  reason StockMovementReason

  // Toujours positive.
  //
  // Le sens du mouvement est porté uniquement par direction.
  //
  // Exemple :
  // achat de 100 m :
  // direction = IN
  // quantity  = 100
  //
  // consommation de 20 m :
  // direction = OUT
  // quantity  = 20
  quantity Decimal @db.Decimal(19, 6)

  // Snapshot de l'unité du stock au moment du mouvement.
  //
  // MTR, C62, KGM...
  //
  // Une fois qu'un CatalogItem possède des mouvements de stock,
  // son unité de stock ne devrait normalement plus pouvoir être modifiée.
  unitCode String


  // ==========================================================================
  // VALORISATION
  // ==========================================================================

  // Coût économique unitaire utilisé pour valoriser ce mouvement.
  //
  // Il s'agit du coût hors TVA récupérable :
  //
  // - TVA entièrement déductible :
  //   achat 4 € HT + 0,80 € TVA -> unitCost = 4 €
  //
  // - TVA non déductible :
  //   achat 4 € HT + 0,80 € TVA -> unitCost = 4,80 €
  //
  // Pour une sortie de stock, il correspond normalement au
  // StockItem.averageUnitCost au moment de la sortie.
  unitCost Decimal? @db.Decimal(19, 6)

  // Snapshot de la valeur économique totale du mouvement.
  //
  // Normalement :
  //
  // quantity * unitCost
  //
  // Arrondi monétaire effectué par le backend.
  totalCost Decimal? @db.Decimal(19, 2)


  // ==========================================================================
  // ORIGINE : ACHAT
  // ==========================================================================

  // Renseigné principalement pour :
  //
  // reason = PURCHASE
  //
  // ou éventuellement SUPPLIER_RETURN lorsque le retour peut
  // être rattaché à l'achat d'origine.
  purchaseItemId String?

  purchaseItem PurchaseItem? @relation(fields: [purchaseItemId],references: [id],onDelete: SetNull)


  // ==========================================================================
  // ORIGINE : CONSOMMATION CHANTIER
  // ==========================================================================

  // Renseigné principalement pour :
  //
  // reason = CONSUMPTION
  //
  // ou RETURN_TO_STOCK lorsqu'un matériau précédemment attribué
  // au WorkLog est remis en stock.
  workLogItemId String?

  workLogItem WorkLogItem? @relation(fields: [workLogItemId],references: [id],onDelete: SetNull)


  // ==========================================================================
  // ANNULATION / CORRECTION
  // ==========================================================================

  // Lorsqu'un mouvement existant est erroné, on ne le modifie pas.
  //
  // On crée un nouveau mouvement REVERSAL de sens opposé et celui-ci
  // référence le mouvement qu'il annule.
  //
  // Exemple :
  //
  // #1 PURCHASE IN 100 m
  //
  // erreur détectée :
  //
  // #2 REVERSAL OUT 100 m
  //    reversedMovementId = #1
  //
  // puis éventuellement :
  //
  // #3 PURCHASE IN 80 m

  reversedMovementId String? @unique

  reversedMovement StockMovement? @relation("StockMovementReversal",fields: [reversedMovementId],references: [id],onDelete: SetNull)

  reversalMovement StockMovement? @relation("StockMovementReversal")


  // ==========================================================================
  // INFORMATIONS COMPLÉMENTAIRES
  // ==========================================================================

  // Principalement utile pour les ajustements manuels :
  //
  // "Correction après inventaire"
  // "5 unités cassées"
  // "Stock initial"
  notes String?

  // Date effective du mouvement.
  //
  // Elle peut être différente de createdAt lorsqu'un achat ou un
  // inventaire est saisi après coup.
  occurredAt DateTime @default(now())

  createdAt DateTime @default(now())


  // ==========================================================================
  // INDEXES
  // ==========================================================================

  @@index([tenantId, occurredAt])

  @@index([stockItemId, occurredAt])

  @@index([purchaseItemId])

  @@index([workLogItemId])

  @@index([reversedMovementId])
}

// ============================================================================
// STOCK ITEM
// ============================================================================

model StockItem {
  id String @id @default(cuid())


  // ==========================================================================
  // PROPRIÉTAIRE
  // ==========================================================================

  tenantId String

  tenant Tenant @relation(fields: [tenantId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // ARTICLE
  // ==========================================================================

  // Un StockItem représente le stock courant d'un CatalogItem.
  //
  // En V1 :
  // un CatalogItem ne possède qu'un seul stock pour l'entreprise.
  //
  // Plus tard, si Workermate gère plusieurs dépôts / véhicules,
  // cette relation pourra évoluer vers :
  //
  // CatalogItem + StockLocation -> StockItem.
  catalogItemId String @unique

  catalogItem CatalogItem @relation(fields: [catalogItemId],references: [id],onDelete: Restrict)


  // ==========================================================================
  // QUANTITÉ DISPONIBLE
  // ==========================================================================

  // Quantité physique actuellement enregistrée dans Workermate.
  //
  // Cette quantité est exprimée dans CatalogItem.unitCode.
  //
  // Exemple :
  //
  // CatalogItem.unitCode = "MTR"
  // quantityOnHand = 82.5
  //
  // -> 82,5 mètres disponibles.
  //
  // La valeur peut être négative :
  //
  // quantityOnHand = -5
  //
  // signifie que Workermate a enregistré plus de consommation
  // que d'entrées de stock.
  //
  // On autorise cela en V1 afin de ne pas bloquer l'artisan
  // lorsqu'un achat n'a simplement pas encore été renseigné.
  quantityOnHand Decimal @default(0) @db.Decimal(19, 6)


  // ==========================================================================
  // VALORISATION
  // ==========================================================================

  // Coût économique unitaire moyen du stock.
  //
  // Il s'agit du coût hors TVA récupérable.
  //
  // Exemple :
  //
  // 100 m à 4 €/m
  // puis
  // 100 m à 6 €/m
  //
  // -> averageUnitCost = 5 €/m
  //
  // Cette valeur sert notamment à valoriser les sorties de stock
  // vers les WorkLogItem.
  //
  // Nullable lorsqu'aucun coût n'est encore connu.
  averageUnitCost Decimal? @db.Decimal(19, 6)


  // ==========================================================================
  // MOUVEMENTS
  // ==========================================================================

  // Journal complet expliquant comment on est arrivé à l'état courant.
  movements StockMovement[]


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================================
  // CONTRAINTES / INDEXES
  // ==========================================================================

  // Un seul stock courant par article et par entreprise en V1.
  @@unique([tenantId, catalogItemId])

  @@index([tenantId])
}

