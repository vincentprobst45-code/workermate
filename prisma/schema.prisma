generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String    @id @default(uuid())
  name      String

  addressId String?
  address   Address?  @relation("TenantMainAddress",fields: [addressId], references: [id], onDelete: Cascade)

  email String?
  phoneNumber String?

  siretNumber String?
  vatNumber String?

  paymentAccounts PaymentAccount[] @relation("TenantPaymentAccounts")

  defaultPaymentAccountId String?

  defaultPaymentAccount PaymentAccount? @relation("TenantDefaultPaymentAccount", fields: [defaultPaymentAccountId], references: [id], onDelete: SetNull)

  invoiceNumberPrefix String @default("FAC")
  nextInvoiceNumber Int @default(1)
  invoiceNumberYear   Int

  vatAccountingMode VatAccountingMode?

  quoteNumberPrefix String @default("DEV")
  nextQuoteNumber Int @default(1)
  quoteNumberYear   Int
  

  logoFileId String?

  defaultCurrency String @default("EUR")

  defaultPaymentTerms String?
  defaultLegalMentions String?
  defaultInvoiceNotes String?

  defaultVatRate Decimal?

  //ASSURANCE
  insuranceName String?
  insurancePolicyNumber String?

  insurerName String?
  insurerAddress String?

  insuranceGeographicCoverage String?

  VatLiabilityRegime VatLiabilityRegime @default(LIABLE)
  vatReturnFrequency VatReturnFrequency @default(MONTHLY)

  createdAt DateTime  @default(now())

  memberships Membership[]
  addresses Address[] @relation("TenantAddresses")
  customers   Customer[]
  quotes    Quote[]
  workOrders    WorkOrder[]
  invoices    Invoice[]
  recurringInvoices RecurringInvoice[]
  calendarevents CalendarEvent[]
  catalogItems CatalogItem[]
  projects Project[]
  workLogs WorkLog[]
  notifications Notification[]
  membershipRequests MembershipRequest[]
  membershipInvitations MembershipInvitation[]
  payments Payment[]
  companyExpenses CompanyExpense[]
  bankTransactions BankTransaction[]
  treasuryReconciliations TreasuryReconciliation[]
  treasuryTransfers TreasuryTransfer[]
  treasuryAlerts TreasuryAlert[]
  purchases Purchase[]
  suppliers Supplier[]
  supplierInvoices SupplierInvoice[]
  stockMovements StockMovement[]
  stockItems StockItem[]

  @@index([defaultPaymentAccountId])
}

enum VatAccountingMode {
  CASH
  DEBITS
}

enum VatLiabilityRegime {
  // L'entreprise bénéficie de la franchise en base.
  FRANCHISE_BASE

  // L'entreprise collecte et déduit normalement la TVA.
  LIABLE
}

enum VatReturnFrequency {
  MONTHLY
  QUARTERLY
}

model PaymentAccount {
  id String @id @default(cuid())

  tenantId String

  tenant Tenant @relation("TenantPaymentAccounts", fields: [tenantId], references: [id], onDelete: Cascade)

  // Tenant qui utilisent ce compte comme compte par défaut.
  //
  // Normalement un seul puisque le compte appartient à un seul tenant,
  // mais Prisma exprime ici la relation inverse.
  defaultForTenants Tenant[] @relation("TenantDefaultPaymentAccount")

  name String
  bankName String?

  accountHolderName String

  iban String
  bic String?

  currency String @default("EUR")

  openingBalance     Decimal  @default(0) @db.Decimal(12, 2)
  openingBalanceDate DateTime?

  archivedAt DateTime?
  closedAt DateTime?
  closedBalance Decimal? @db.Decimal(12, 2)

  recurringInvoices RecurringInvoice[]
  bankTransactions BankTransaction[]
  companyExpenses CompanyExpense[]
  reconciliations TreasuryReconciliation[]
  alerts TreasuryAlert[]
  outgoingTransfers TreasuryTransfer[] @relation("TransferFromAccount")
  incomingTransfers TreasuryTransfer[] @relation("TransferToAccount")
  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, iban])
  @@index([tenantId])
  @@index([tenantId, archivedAt])
}

model User {
  id         String       @id @default(uuid())
  email      String       @unique
  password   String
  firstname  String?
  lastname   String?
  activeTenantId String?

  addressId String?
  address   Address?  @relation(fields: [addressId], references: [id], onDelete: Cascade)

  createdAt  DateTime     @default(now())

  memberships Membership[]
  createdCustomers Customer[] @relation("CustomerCreator")
  createdWorkOrders    WorkOrder[] @relation("WorkOrderCreator")
  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreator")
  createdRecurringInvoices RecurringInvoice[] @relation("RecurringInvoiceCreator")
  passwordResetTokens PasswordResetToken[]
  receivedNotifications Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationSender")
  membershipRequests MembershipRequest[]
  respondedMembershipRequests MembershipRequest[] @relation("MembershipRequestResponder")
  sentMembershipInvitations MembershipInvitation[] @relation("MembershipInvitationSender")
  receivedMembershipInvitations MembershipInvitation[] @relation("MembershipInvitationRecipient")
  createdWorkLogs WorkLog[] @relation("WorkLogCreator")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Membership {
  userId   String
  tenantId String
  role     TenantRole
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([userId, tenantId])
}

model Address {
  id String @id @default(cuid())

  tenantId String
  tenant Tenant @relation("TenantAddresses", fields: [tenantId], references: [id], onDelete: Cascade)

  // Adresse
  street1 String
  street2 String?

  postalCode String
  city       String
  region     String?
  countryCode String @default("FR")

  // Coordonnées GPS (optionnel)
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // Informations complémentaires
  accessCode String?
  floor      String?
  apartment  String?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  quotes Quote[]
  customers Customer[]
  workOrders WorkOrder[]
  tenants Tenant[] @relation("TenantMainAddress")
  users User[]
  calendarevents CalendarEvent[]
}

model Customer {
  id        String   @id @default(uuid())

  // Relation
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User? @relation("CustomerCreator", fields: [createdById], references: [id])

  // Identité
  firstName String?
  lastName  String?
  company   String?

  // Contact
  email     String?
  phone     String?
  mobile    String?


  // Addresse de facturation
  addressId String?
  address   Address?  @relation(fields: [addressId], references: [id], onDelete: Cascade)


  // Professionnels
  siret     String?
  vatNumber String?

  // Divers
  notes     String?

  // Relations
  quotes    Quote[]
  workOrders    WorkOrder[]
  calendarevents CalendarEvent[]
  invoices Invoice[]
  recurringInvoices RecurringInvoice[]
  projects ProjectCustomer[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([tenantId])
  @@index([lastName])
  @@index([company])
}

model CalendarEvent {
  id          String   @id @default(cuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  addressId   String?
  address     Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)

  workOrderId   String?
  workOrder     WorkOrder?  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User? @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title       String
  description String?

  startDate   DateTime
  endDate     DateTime
  
  allDay Boolean @default(false)
  status CalendarEventStatus @default(SCHEDULED)

  type CalendarEventType @default(OTHER)

  color     String?

  notes     String?

  workLogs WorkLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@index([tenantId, startDate])
  @@index([projectId, startDate])
}

enum CalendarEventType {
  CUSTOMER_APPOINTMENT
  SITE_VISIT
  WORK
  MAINTENANCE
  DELIVERY
  ADMINISTRATIVE
  ABSENCE
  OTHER
}

model WorkOrder {
  id String @id @default(cuid())

  // ==========================================================================
  // TENANT / CRÉATION
  // ==========================================================================

  tenantId String
  tenant Tenant @relation(fields: [tenantId],references: [id],onDelete: Cascade)

  createdById String?
  createdBy User? @relation("WorkOrderCreator",fields: [createdById],references: [id],onDelete: SetNull)


  // ==========================================================================
  // CLIENT / PROJET
  // ==========================================================================

  customerId String?
  customer Customer? @relation(fields: [customerId],references: [id],onDelete: SetNull)

  projectId String?
  project Project? @relation(fields: [projectId],references: [id],onDelete: SetNull)


  // ==========================================================================
  // LIEU D'INTERVENTION
  // ==========================================================================

  addressId String?
  address Address? @relation(fields: [addressId],references: [id],onDelete: SetNull)

  // Snapshot du lieu d'intervention.
  //
  // Permet de conserver l'adresse historique même si Address
  // est ensuite modifiée.
  addressStreet1 String?
  addressStreet2 String?
  addressPostalCode String?
  addressCity String?
  addressCountryCode String?


  // ==========================================================================
  // IDENTITÉ DU WORK ORDER
  // ==========================================================================

  // Référence unique uniquement dans l'entreprise.
  reference String

  title String
  description String?

  status WorkOrderStatus @default(DRAFT)


  // ==========================================================================
  // PLANIFICATION
  // ==========================================================================

  // Je préfère "planned..." car WorkLog représente ensuite le réel.
  plannedStartDate DateTime?
  plannedEndDate DateTime?

  // Toujours stocker une durée dans une unité explicite.
  plannedDurationMinutes Int?


  // ==========================================================================
  // SUIVI
  // ==========================================================================

  // Date à laquelle le WorkOrder a réellement été considéré terminé.
  completedAt DateTime?

  // Notes internes.
  internalNotes String?


  // ==========================================================================
  // RELATIONS
  // ==========================================================================

  items WorkOrderItem[]

  quotes Quote[]
  invoices Invoice[]
  recurringInvoices RecurringInvoice[]

  documents Document[]
  calendarevents CalendarEvent[]
  workLogs WorkLog[]
  purchaseItems PurchaseItem[]


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?


  // ==========================================================================
  // CONTRAINTES / INDEX
  // ==========================================================================

  @@unique([tenantId, reference])

  @@index([tenantId, status])
  @@index([customerId])
  @@index([projectId])
  @@index([plannedStartDate])
}

model WorkOrderItem {
  id String @id @default(cuid())

  workOrderId String
  workOrder WorkOrder @relation(fields: [workOrderId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // IDENTIFICATION
  // ==========================================================================

  type LineItemType

  position Int

  // Snapshot éventuel de CatalogItem.reference.
  sellerItemIdentifier String?

  title String
  description String?


  // ==========================================================================
  // QUANTITÉ / UNITÉ
  // ==========================================================================

  quantity Decimal @default(1) @db.Decimal(19, 6)

  // Code normalisé :
  // C62, HUR, KGM, MTR...
  unitCode String

  // Affichage utilisateur :
  // unité, heure, kg, m...
  unitLabel String?

  // Quantité sur laquelle porte unitPrice.
  baseQuantity Decimal @default(1) @db.Decimal(19, 6)

  baseQuantityUnitCode String?


  // ==========================================================================
  // PRIX DE VENTE PRÉVU
  // ==========================================================================

  // Prix unitaire HT prévu.
  unitPrice Decimal @db.Decimal(19, 6)

  // Montant net HT prévu de cette ligne.
  //
  // Très utile pour le budget du projet.
  subtotal Decimal @db.Decimal(19, 2)


  // ==========================================================================
  // TVA DE VENTE
  // ==========================================================================

  vatCategory VatCategory @default(STANDARD)

  vatRate Decimal? @db.Decimal(5, 2)


  // ==========================================================================
  // COÛT PRÉVU
  // ==========================================================================

  // Coût unitaire HT prévu pour ce WorkOrder.
  //
  // Peut initialement être copié depuis CatalogItem.unitCost,
  // mais devient ensuite indépendant.
  unitCost Decimal? @db.Decimal(19, 6)

  // TVA d'achat indicative.
  //
  // Sert aux estimations uniquement.
  // La réalité viendra plus tard des achats / factures fournisseurs.
  purchaseVatRate Decimal? @db.Decimal(5, 2)


  // ==========================================================================
  // CONTRAINTES
  // ==========================================================================

  workLogItems WorkLogItem[]
  
  @@unique([workOrderId, position])
  @@index([workOrderId])
}

model Document {

  id String @id @default(cuid())

  workOrderId String
  workOrder WorkOrder @relation(fields:[workOrderId], references:[id], onDelete:Cascade)

  type DocumentType

  reference String @unique

  status DocumentStatus

  issuedAt DateTime?

  dueAt DateTime?

  notes String?

  createdAt DateTime @default(now())

  items DocumentItem[]
}

model DocumentItem {

  id String @id @default(cuid())

  documentId String
  document Document @relation(fields:[documentId], references:[id], onDelete:Cascade)

  position Int

  type LineItemType

  title String

  description String?

  quantity Decimal @db.Decimal(10,2)

  unit String?

  unitPrice Decimal @db.Decimal(10,2)

  vatRate Decimal @db.Decimal(4,2)
}

enum InvoiceKind {
  STANDARD
  DEPOSIT
  PROGRESS
  BALANCE
  CORRECTIVE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  REPLACED
  CANCELLED
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model InvoiceAdjustment {
  // WM — Identifiant technique.
  id String @id @default(cuid())

  invoiceId String
  invoice Invoice @relation(fields: [invoiceId],references: [id],onDelete: Cascade)

  // WM — Ordre d'affichage.
  position Int @default(0)

  // WM :
  //
  // ALLOWANCE -> remise globale / BG-20
  // CHARGE    -> charge globale / BG-21
  type InvoiceAdjustmentType


  // ==========================================================================
  // MONTANT
  // ==========================================================================

  // FE :
  //
  // ALLOWANCE -> BT-92
  // CHARGE    -> BT-99
  amount Decimal @db.Decimal(19, 2)

  // FE :
  //
  // ALLOWANCE -> BT-93
  // CHARGE    -> BT-100
  baseAmount Decimal? @db.Decimal(19, 2)

  // FE :
  //
  // ALLOWANCE -> BT-94
  // CHARGE    -> BT-101
  percentage Decimal? @db.Decimal(9, 6)


  // ==========================================================================
  // TVA
  // ==========================================================================

  // FE :
  //
  // ALLOWANCE -> BT-95
  // CHARGE    -> BT-102
  //
  // Une remise/charge documentaire doit être rattachée
  // à une catégorie TVA.
  vatCategory VatCategory

  // FE :
  //
  // ALLOWANCE -> BT-96
  // CHARGE    -> BT-103
  vatRate Decimal? @db.Decimal(5, 2)


  // ==========================================================================
  // MOTIF
  // ==========================================================================

  // FE :
  //
  // ALLOWANCE -> BT-97
  // CHARGE    -> BT-104
  reason String?

  // FE :
  //
  // ALLOWANCE -> BT-98
  // CHARGE    -> BT-105
  reasonCode String?

  @@unique([invoiceId, position])
  @@index([invoiceId])
}

model Invoice {
  // ==========================================================================
  // IDENTITÉ WORKERMATE
  // ==========================================================================

  // WM — Identifiant technique interne Workermate.
  // Aucune correspondance directe avec la facture électronique.
  id String @id @default(cuid())

  // WM — Entreprise propriétaire de la facture.
  // Sert notamment à garantir le cloisonnement multi-tenant.
  tenantId String
  tenant Tenant @relation(fields: [tenantId],references: [id],onDelete: Restrict)

  // WM — Client Workermate auquel appartient la facture.
  customerId String
  customer Customer @relation(fields: [customerId],references: [id],onDelete: Restrict)

  // WM — WorkOrder à l'origine de la facture, si applicable.
  workOrderId String?
  workOrder WorkOrder? @relation(fields: [workOrderId],references: [id],onDelete: SetNull)

  // WM — Projet auquel la facture appartient, si applicable.
  projectId String?
  project Project? @relation(fields: [projectId],references: [id],onDelete: SetNull)

  // WM — Devis à l'origine de la facture, si applicable.
  quoteId String?
  quote Quote? @relation(fields: [quoteId],references: [id],onDelete: SetNull)


  // ==========================================================================
  // IDENTIFICATION DU DOCUMENT
  // ==========================================================================

  // FE BT-1 — Numéro de facture.
  //
  // Nullable tant que la facture est DRAFT :
  // le vrai numéro est attribué au moment de l'émission afin de préserver
  // une séquence chronologique et continue.
  number String?

  // WM → FE BT-3 — Nature métier du document.
  //
  // Mapping typique :
  // STANDARD   -> 380
  // DEPOSIT    -> 386
  // PROGRESS   -> 380
  // BALANCE    -> 380
  // CORRECTIVE -> 384
  // CREDIT_NOTE-> 381
  //
  // Le mapper électronique reste responsable du code BT-3 réel.
  kind InvoiceKind @default(STANDARD)

  // WM — État métier du document dans Workermate.
  //
  // DRAFT     : non émise
  // ISSUED    : document officiellement émis
  // REPLACED  : remplacée par une CORRECTIVE
  // CANCELLED : annulée selon les règles métier autorisées
  //
  // Ne doit pas être confondu avec les statuts de cycle de vie électroniques.
  status InvoiceStatus @default(DRAFT)

  // FE BT-2 — Date d'émission de la facture.
  //
  // Nullable en DRAFT et obligatoire lors du passage à ISSUED.
  issueDate DateTime?

  // WM — Horodatage technique précis du passage à ISSUED.
  // Différent de BT-2 qui représente la date portée sur le document.
  issuedAt DateTime?

  // FE BT-9 — Date d'échéance / date limite de paiement.
  dueDate DateTime?


  // ==========================================================================
  // CADRE DE FACTURATION
  // ==========================================================================

  // WM → FE BT-23 — Catégorie générale de l'opération :
  // GOODS / SERVICES / MIXED.
  //
  // Attention : BT-23 est plus riche que cette seule valeur.
  // Le backend l'utilise avec kind et le contexte pour déterminer par exemple :
  // B1 / S1 / M1, B4 / S4 / M4, S5, S6, etc.
  operationCategory InvoiceOperationCategory

  // FE BT-23 — Snapshot du code de cadre de facturation finalement déterminé
  // au moment de l'émission.
  //
  // Exemples actuels : B1, S1, M1, B4, S4, M4, S5...
  //
  // Cela évite d'avoir à recalculer plusieurs années plus tard le code
  // électronique qui avait été utilisé pour cette facture.
  billingFrameworkCode String?

  // WM → FE BT-8 — Régime d'exigibilité de TVA pertinent notamment
  // pour distinguer TVA sur les débits / TVA sur les encaissements.
  //
  // Le mapper transforme l'enum métier en valeur normative.
  vatAccountingMode VatAccountingMode?


  // ==========================================================================
  // DEVISES
  // ==========================================================================

  // FE BT-5 — Devise de la facture, code ISO 4217.
  currency String @default("EUR")

  // FE BT-6 — Devise de comptabilité.
  //
  // Notamment nécessaire lorsque la facture est dans une autre devise
  // et que la TVA doit également être fournie en EUR.
  accountingCurrency String?

  // FE BT-111 — Montant de TVA dans la devise de comptabilité.
  // Principalement utile lorsque currency != EUR.
  vatAmountAccountingCurrency Decimal? @db.Decimal(19, 2)


  // ==========================================================================
  // RÉFÉRENCES COMMERCIALES
  // ==========================================================================

  // FE BT-10 — Référence fournie par l'acheteur.
  buyerReference String?

  // FE BT-11 — Référence de projet.
  projectReference String?

  // WM — Snapshot lisible du titre du projet.
  // Pas de BT direct.
  projectTitle String?

  // FE BT-12 — Référence de contrat lorsqu'elle existe.
  contractReference String?

  // FE BT-13 — Référence du bon de commande de l'acheteur.
  purchaseOrderReference String?

  // FE BT-14 — Référence de commande du vendeur.
  salesOrderReference String?

  // WM — Snapshot du devis Workermate.
  // Ne doit pas être automatiquement assimilé à BT-13 ou BT-14 :
  // le mapper choisira la sémantique appropriée selon le cas.
  quoteNumber String?

  // WM — Snapshot du WorkOrder.
  workOrderReference String?

  // WM — Snapshot du titre du WorkOrder.
  workOrderTitle String?


  // ==========================================================================
  // FACTURE RECTIFICATIVE
  // ==========================================================================

  // WM — Relation métier "annule et remplace".
  //
  // Obligatoire lorsque kind = CORRECTIVE.
  // Une CORRECTIVE doit viser exactement une facture précédente.
  correctedInvoiceId String?

  correctedInvoice Invoice? @relation("InvoiceCorrection",fields: [correctedInvoiceId],references: [id],onDelete: Restrict)

  // WM — Permet de retrouver la ou les tentatives de correction de cette facture.
  correctingInvoices Invoice[] @relation("InvoiceCorrection")

  // FE BT-25 — Snapshot du numéro de la facture directement rectifiée.
  //
  // On le conserve même si correctedInvoice existe encore en base :
  // le document émis reste autonome.
  correctedInvoiceNumber String?

  // FE BT-26 — Snapshot de la date de la facture directement rectifiée.
  correctedInvoiceIssueDate DateTime?


  // ==========================================================================
  // FACTURES ANTÉRIEURES
  // ==========================================================================

  // FE BG "Référence à une facture antérieure", notamment BT-25 / BT-26
  // selon le scénario d'export.
  //
  // Utilisé par exemple par une PROGRESS ou une BALANCE pour conserver
  // les facturations précédentes nécessaires au récapitulatif.
  //
  // Pour une CORRECTIVE 384, la référence de correction réglementaire
  // provient de correctedInvoice* ; references[] reste le contexte historique.
  references InvoiceReference[] @relation("InvoiceReferenceSource")

  // WM — Relation inverse :
  // factures qui citent cette facture dans leur historique.
  referencedBy InvoiceReference[] @relation("InvoiceReferenceTarget")


  // ==========================================================================
  // SNAPSHOT DU VENDEUR
  // ==========================================================================

  // FE BT-27 — Nom / raison sociale du vendeur.
  tenantName String

  // FE BT-28
  tenantTradingName String?

  // FE BT-30 — SIREN du vendeur.
  // Donnée particulièrement importante dans la réforme française.
  tenantSirenNumber String

  // FE BT-29 avec schemeID 0009 — SIRET du vendeur.
  tenantSiretNumber String?

  // FE BT-31 — Numéro de TVA intracommunautaire du vendeur.
  tenantVatNumber String?

  // FE BT-33 / affichage légal
  tenantLegalForm String?

  // Mention PDF légale
  tenantShareCapital Decimal? @db.Decimal(19, 2)

  // Exemple : "RCS Orléans 123 456 789"
  tenantRegistrationMention String?

  //ASSURANCE
  tenantInsuranceName String?
  tenantInsurancePolicyNumber String?

  tenantInsurerName String?
  tenantInsurerAddress String?

  tenantInsuranceGeographicCoverage String?

  // FE BT-35 — Ligne 1 de l'adresse du vendeur.
  tenantStreet1 String

  // FE BT-36 — Ligne 2 de l'adresse du vendeur.
  tenantStreet2 String?

  // FE BT-37 — Ville du vendeur.
  tenantCity String

  // FE BT-38 — Code postal du vendeur.
  tenantPostalCode String

  // FE BT-40 — Code pays ISO du vendeur.
  tenantCountryCode String

  // FE BT-34 — Adresse électronique de routage du vendeur.
  //
  // ATTENTION : ce n'est pas nécessairement son email de contact.
  tenantElectronicAddress String?

  // FE BT-34-1 — Scheme de l'adresse électronique.
  // Exemple : 0225 dans les scénarios français correspondants.
  tenantElectronicAddressScheme String?

  // FE BT-41 — Nom du contact vendeur.
  tenantContactName String?

  // FE BT-42 — Téléphone du contact vendeur.
  tenantPhoneNumber String?

  // FE BT-43 — Email du contact vendeur.
  // À ne pas confondre avec tenantElectronicAddress.
  tenantEmail String?


  // ==========================================================================
  // SNAPSHOT DE L'ACHETEUR
  // ==========================================================================

  // FE BT-44 — Nom / raison sociale exacte de l'acheteur portée sur la facture.
  //
  // Pour un particulier : par exemple "Jean Dupont".
  // Pour une entreprise : par exemple "Dupont Électricité SARL".
  customerName String

  // FE BT-47 — SIREN de l'acheteur.
  // Nullable car le client peut être un particulier ou un acteur étranger.
  customerSirenNumber String?

  // FE BT-46 avec schemeID 0009 — SIRET de l'acheteur si utilisé.
  customerSiretNumber String?

  // FE BT-48 — Numéro de TVA intracommunautaire de l'acheteur.
  customerVatNumber String?

  // FE BT-50 — Ligne 1 de l'adresse de l'acheteur.
  customerStreet1 String

  // FE BT-51 — Ligne 2 de l'adresse de l'acheteur.
  customerStreet2 String?

  // FE BT-52 — Ville de l'acheteur.
  customerCity String

  // FE BT-53 — Code postal de l'acheteur.
  customerPostalCode String

  // FE BT-55 — Code pays ISO de l'acheteur.
  customerCountryCode String

  // FE BT-49 — Adresse électronique de routage de l'acheteur.
  //
  // En e-invoicing français, ce n'est pas simplement customerEmail.
  customerElectronicAddress String?

  // FE BT-49-1 — Scheme de l'adresse électronique de l'acheteur.
  customerElectronicAddressScheme String?

  // FE BT-56 — Nom du contact acheteur.
  customerContactName String?

  // FE BT-57 — Téléphone du contact acheteur.
  customerPhoneNumber String?

  // FE BT-58 — Email du contact acheteur.
  customerEmail String?


  // ==========================================================================
  // LIVRAISON / PRESTATION / PÉRIODE FACTURÉE
  // ==========================================================================

  // FE BT-72 — Date effective de livraison du bien ou date de fin
  // d'exécution de la prestation.
  //
  // Elle ne remplace ni issueDate ni dueDate.
  supplyDate DateTime?

  // FE BT-73 — Début de la période de facturation/prestation.
  billingPeriodStart DateTime?

  // FE BT-74 — Fin de la période de facturation/prestation.
  billingPeriodEnd DateTime?

  // FE BT-70 — Nom du destinataire de la livraison, si pertinent.
  deliveryName String?

  // FE BT-71 — Identifiant du lieu de livraison, si pertinent.
  deliveryLocationId String?

  // FE BT-75 — Adresse de livraison ligne 1.
  deliveryStreet1 String?

  // FE BT-76 — Adresse de livraison ligne 2.
  deliveryStreet2 String?

  // FE BT-77 — Ville de livraison.
  deliveryCity String?

  // FE BT-78 — Code postal de livraison.
  deliveryPostalCode String?

  // FE BT-80 — Code pays de livraison.
  deliveryCountryCode String?

  // WM — Snapshot temporel du WorkOrder.
  // Peut servir à préremplir les données ci-dessus mais ne les remplace pas.
  workOrderStartDate DateTime?
  workOrderEndDate DateTime?

  // WM — Adresse métier du WorkOrder.
  // Ne doit pas être automatiquement considérée comme l'adresse de livraison FE.
  workOrderAddress String?
  workOrderPostalCode String?
  workOrderCity String?


  // ==========================================================================
  // TOTAUX DU DOCUMENT
  // ==========================================================================

  // FE BT-106 — Somme des montants nets HT de toutes les InvoiceItem.
  lineNetTotal Decimal @db.Decimal(19, 2)

  // FE BT-107 — Somme des remises au niveau du DOCUMENT.
  //
  // Calculée depuis adjustments[] de type ALLOWANCE au niveau Invoice.
  allowanceTotal Decimal @default(0) @db.Decimal(19, 2)

  // FE BT-108 — Somme des charges/frais au niveau du DOCUMENT.
  //
  // Calculée depuis adjustments[] de type CHARGE.
  chargeTotal Decimal @default(0) @db.Decimal(19, 2)

  // FE BT-109 — Montant total HT de la facture.
  //
  // lineNetTotal - allowanceTotal + chargeTotal
  taxExclusiveAmount Decimal @db.Decimal(19, 2)

  // FE BT-110 — Montant total de TVA du document.
  // Doit être cohérent avec vatBreakdowns[].
  vatAmount Decimal @db.Decimal(19, 2)

  // FE BT-112 — Montant total TTC du document.
  //
  // Pour CREDIT_NOTE, on conserve également des montants documentaires positifs ;
  // l'effet financier négatif est déterminé par kind.
  taxInclusiveAmount Decimal @db.Decimal(19, 2)

  // FE BT-113 — Montant déjà payé AVANT l'établissement de cette facture.
  //
  // Important notamment pour une facture définitive après acompte.
  //
  // ATTENTION : ce champ n'est PAS le montant actuellement encaissé calculé
  // depuis payments[].
  prepaidAmount Decimal @default(0) @db.Decimal(19, 2)

  // FE BT-114 — Montant d'arrondi éventuel.
  roundingAmount Decimal @default(0) @db.Decimal(19, 2)

  // FE BT-115 — Net à payer porté par le document lors de son émission.
  //
  // taxInclusiveAmount - prepaidAmount + roundingAmount
  amountDue Decimal @db.Decimal(19, 2)


  // ==========================================================================
  // ÉTAT ACTUEL DES RÈGLEMENTS — WORKERMATE
  // ==========================================================================

  // WM — Somme actuelle des Payment associés à cette facture.
  //
  // Valeur dénormalisée maintenue uniquement par le backend pour accélérer
  // les listes, filtres et dashboards.
  //
  // Ne jamais mapper aveuglément ce champ sur BT-113 :
  // BT-113 est figé à l'émission ; paidAmount continue d'évoluer ensuite.
  paidAmount Decimal @default(0) @db.Decimal(19, 2)

  // WM — État calculé depuis paidAmount et le montant à régler.
  //
  // UNPAID / PARTIALLY_PAID / PAID.
  paymentStatus InvoicePaymentStatus @default(UNPAID)

  // WM — Encaissements réellement affectés à cette facture.
  payments Payment[]


  // ==========================================================================
  // INSTRUCTIONS DE PAIEMENT DU DOCUMENT
  // ==========================================================================

  // FE BT-20 — Conditions de paiement en texte libre.
  // Exemple : "Paiement à 30 jours".
  paymentTerms String?

  // FE BT-81 — Code normalisé du moyen de paiement demandé.
  // Exemple : virement, prélèvement, etc.
  paymentMeansCode String?

  // FE BT-82 — Description textuelle du moyen de paiement, si nécessaire.
  paymentMeansText String?

  // FE BT-83 — Référence de paiement à reprendre par le client.
  paymentReference String?

  // FE BT-84 — Identifiant du compte de paiement, typiquement l'IBAN.
  paymentIban String?

  // FE BT-85 — Nom du compte bancaire bénéficiaire.
  paymentAccountName String?

  // FE BT-86 — Identifiant du prestataire bancaire, typiquement BIC.
  paymentBic String?


  // ==========================================================================
  // REMISES / CHARGES / TVA / NOTES
  // ==========================================================================

  // FE BG-20 / BG-21 — Remises et charges au niveau de toute la facture.
  //
  // InvoiceAdjustment porte notamment les données correspondant à
  // BT-92..98 (remise) ou BT-99..105 (charge).
  adjustments InvoiceAdjustment[]

  // FE BG-23 — Ventilation de TVA.
  //
  // InvoiceVatBreakdown porte notamment :
  // BT-116 base taxable
  // BT-117 TVA
  // BT-118 catégorie TVA
  // BT-119 taux
  // BT-120 motif d'exonération
  // BT-121 code du motif d'exonération
  vatBreakdowns InvoiceVatBreakdown[]

  // FE BG-1 — Notes de facture structurées.
  //
  // InvoiceNote doit porter :
  // BT-21 code sujet
  // BT-22 texte
  //
  // Cela remplace avantageusement un unique "legalMentions String?"
  // pour les besoins de la facturation électronique.
  notes InvoiceNote[]

  // WM — Notes strictement internes à Workermate.
  // Ne doivent jamais apparaître sur le PDF ou dans la facture électronique.
  internalNotes String?


  // ==========================================================================
  // LIGNES
  // ==========================================================================

  // FE BG-25 — Lignes de facture.
  //
  // InvoiceItem porte notamment BT-126, BT-129, BT-130, BT-131,
  // BT-146..150, BT-151..154, etc.
  items InvoiceItem[]


  // ==========================================================================
  // DOCUMENTS GÉNÉRÉS
  // ==========================================================================

  // WM — Fichier PDF lisible généré pour cette facture.
  // Le futur Factur-X peut également utiliser ce PDF comme partie visuelle.
  pdfFileId String?


  // ==========================================================================
  // FACTURATION ÉLECTRONIQUE / PLATEFORME AGRÉÉE
  // ==========================================================================

  // WM — État technique de transmission électronique.
  //
  // Ce n'est pas un BT de facture : les statuts appartiennent au cycle
  // de vie électronique.
  //
  // Le nom "pdpStatus" peut être conservé pour le moment,
  // mais le terme officiel utilisé aujourd'hui est "plateforme agréée".
  pdpStatus InvoicePdpStatus @default(NOT_SENT)

  // WM — Identifiant/message retourné par la plateforme.
  // Aucun BT direct.
  pdpMessageId String?

  // WM — Date de première transmission à une plateforme agréée.
  pdpSentAt DateTime?

  //
  // Pièces jointes
  //
  attachments InvoiceAttachment[]


  // ==========================================================================
  // FACTURE RECCURENTE
  // ==========================================================================

  // Récurrence ayant généré cette facture.
  recurringInvoiceId String?

  recurringInvoice RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)


  // ==========================================================================
  // MÉTADONNÉES WORKERMATE
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // Occurrence exacte représentée par cette facture.
  //
  // Exemple :
  // facture mensuelle d'octobre -> 2026-10-01
  recurrenceDate DateTime? @db.Date


  // ==========================================================================
  // CONTRAINTES / INDEX
  // ==========================================================================

  // Numérotation propre à chaque entreprise.
  // Plusieurs DRAFT peuvent avoir number = null.
  @@unique([tenantId, number])
  
  @@unique([recurringInvoiceId, recurrenceDate])

  @@index([tenantId, issueDate])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])

  @@index([customerId, issueDate])
  @@index([projectId, issueDate])
  @@index([workOrderId, issueDate])
  @@index([quoteId])

  @@index([correctedInvoiceId])
}

enum InvoiceOperationCategory {
  GOODS
  SERVICES
  MIXED
}

model InvoiceAttachment {
  id String @id @default(cuid())

  invoiceId String
  invoice Invoice @relation(fields: [invoiceId],references: [id],onDelete: Cascade)

  fileId String

  // FE BT-122
  reference String

  // FE BT-123
  description String?

  // BT-124
  url String?

  // Snapshot du fichier (FICHIER = BT-125)
  fileName String
  mimeType String

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceReference {
  // ==========================================================================
  // FACTURE QUI FAIT LA RÉFÉRENCE
  // ==========================================================================

  invoiceId String

  invoice Invoice @relation("InvoiceReferenceSource",fields: [invoiceId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // FACTURE RÉFÉRENCÉE
  // ==========================================================================

  referencedInvoiceId String

  referencedInvoice Invoice @relation("InvoiceReferenceTarget",fields: [referencedInvoiceId],references: [id],onDelete: Restrict)


  // ==========================================================================
  // SNAPSHOT DOCUMENTAIRE
  // ==========================================================================

  // FE BT-25 — Numéro de la facture antérieure lorsqu'elle est
  // sérialisée comme référence à une facture précédente.
  referencedInvoiceNumber String

  // FE BT-26 — Date d'émission de la facture antérieure.
  referencedInvoiceIssueDate DateTime

  // WM — Nature du document référencé au moment où le snapshot est créé.
  //
  // Utile pour construire le PDF/récapitulatif sans dépendre
  // de l'état futur de la facture référencée.
  referencedInvoiceKind InvoiceKind

  // WM — Snapshot du montant TTC du document référencé.
  //
  // Utile par exemple pour le récapitulatif d'une facture BALANCE.
  // Ce n'est pas directement BT-25/BT-26.
  referencedInvoiceTaxInclusiveAmount Decimal? @db.Decimal(19, 2)

  // WM — Ordre d'affichage dans un récapitulatif.
  position Int @default(0)

  @@id([invoiceId, referencedInvoiceId])
  @@index([referencedInvoiceId])
  @@index([invoiceId, position])
}

model InvoiceNote {
  // WM — Identifiant technique.
  id String @id @default(cuid())

  invoiceId String
  invoice Invoice @relation(fields: [invoiceId],references: [id],onDelete: Cascade)

  // WM — Ordre d'affichage des notes.
  position Int @default(0)

  // FE BT-21 — Code sujet de la note.
  //
  // Certains scénarios français utilisent des codes spécifiques
  // pour qualifier la nature d'une information.
  subjectCode String?

  // FE BT-22 — Texte de la note.
  text String

  @@unique([invoiceId, position])
  @@index([invoiceId])
}

model InvoiceItem {
  // ==========================================================================
  // IDENTITÉ WORKERMATE
  // ==========================================================================

  // WM — Identifiant technique interne.
  id String @id @default(cuid())

  invoiceId String
  invoice Invoice @relation(fields: [invoiceId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // IDENTIFICATION DE LA LIGNE
  // ==========================================================================

  // WM — Ordre d'affichage de la ligne.
  //
  // N'est pas directement une donnée fiscale.
  position Int

  // FE BT-126 — Identifiant de ligne de facture.
  //
  // Pour les factures créées par Workermate :
  // "1", "2", "3", etc.
  //
  // On le sépare de position pour pouvoir un jour importer/reproduire
  // une facture dont l'identifiant de ligne n'est pas simplement un entier.
  lineIdentifier String

  // FE BT-127 — Notes libres de ligne.
  //
  // Plusieurs notes peuvent exister.
  notes String[] @default([])

  // FE BT-128 — Identifiant de l'objet facturé, lorsque pertinent.
  //
  // Exemples possibles :
  // compteur, équipement, objet contractuel, référence spécifique...
  objectIdentifier String?


  // ==========================================================================
  // TYPE WORKERMATE
  // ==========================================================================

  // WM — Catégorie fonctionnelle interne.
  //
  // Exemples : MATERIAL, LABOR, EQUIPMENT, SERVICE...
  // Ce champ ne doit pas être confondu avec une catégorie normalisée FE.
  type LineItemType


  // ==========================================================================
  // QUANTITÉ
  // ==========================================================================

  // FE BT-129 — Quantité facturée.
  //
  // On conserve plus de deux décimales :
  // 1.333 heure, 0.125 m³, etc.
  quantity Decimal @db.Decimal(19, 6)

  // FE BT-130 — Code d'unité de mesure normalisé.
  //
  // Exemples :
  // C62 = unité
  // HUR = heure
  // KGM = kilogramme
  // MTR = mètre
  //
  // Le PDF peut afficher un libellé plus humain via unitLabel.
  unitCode String

  // WM — Libellé utilisé dans l'interface/PDF.
  //
  // Exemples :
  // "unité", "heure", "kg", "m".
  //
  // Ne remplace jamais BT-130 lors de l'export.
  unitLabel String?


  // ==========================================================================
  // MONTANT NET DE LIGNE
  // ==========================================================================

  // FE BT-131 — Montant net HT de la ligne.
  //
  // Il tient compte :
  // quantité × prix net
  // - remises de ligne
  // + charges de ligne.
  //
  // C'est le montant qui participe à Invoice.lineNetTotal / BT-106.
  subtotal Decimal @db.Decimal(19, 2)


  // ==========================================================================
  // RÉFÉRENCES ACHETEUR
  // ==========================================================================

  // FE BT-132 — Référence à une ligne de bon de commande acheteur.
  purchaseOrderLineReference String?

  // FE BT-133 — Référence comptable fournie par l'acheteur pour cette ligne.
  buyerAccountingReference String?


  // ==========================================================================
  // PÉRIODE DE LA LIGNE
  // ==========================================================================

  // FE BT-134 — Début de la période concernée par cette ligne.
  //
  // Exemple :
  // maintenance du 01/07 au 31/07.
  billingPeriodStart DateTime?

  // FE BT-135 — Fin de la période concernée par cette ligne.
  billingPeriodEnd DateTime?


  // ==========================================================================
  // PRIX
  // ==========================================================================

  // FE BT-146 — Prix unitaire NET HT.
  //
  // Obligatoire.
  //
  // C'est le prix après éventuel rabais sur le prix brut.
  unitPrice Decimal @db.Decimal(19, 6)

  // FE BT-147 — Rabais appliqué au prix unitaire brut
  // pour arriver au prix unitaire net.
  //
  // Attention : ce n'est PAS la même chose qu'une remise de ligne
  // InvoiceItemAdjustment.
  unitPriceDiscountAmount Decimal? @db.Decimal(19, 6)

  // FE BT-148 — Prix unitaire BRUT avant le rabais BT-147.
  grossUnitPrice Decimal? @db.Decimal(19, 6)

  // FE BT-149 — Quantité de base à laquelle s'applique le prix.
  //
  // Exemple :
  // 20 € pour 100 vis :
  //
  // unitPrice = 20
  // baseQuantity = 100
  baseQuantity Decimal @default(1) @db.Decimal(19, 6)

  // FE BT-150 — Code d'unité correspondant à baseQuantity.
  //
  // Souvent identique à unitCode.
  baseQuantityUnitCode String?


  // ==========================================================================
  // TVA DE LA LIGNE
  // ==========================================================================

  // FE BT-151 — Code de catégorie TVA de la ligne.
  vatCategory VatCategory

  // FE BT-152 — Taux de TVA de la ligne.
  //
  // Nullable notamment lorsque la catégorie normative n'autorise
  // ou ne nécessite pas de taux.
  vatRate Decimal? @db.Decimal(5, 2)

  // EXT-FR-FE-178 — Motif textuel d'exemption au niveau ligne,
  // lorsque le profil français et le scénario l'utilisent.
  vatExemptionReason String?

  // EXT-FR-FE-179 — Code normalisé du motif d'exemption en ligne.
  vatExemptionReasonCode String?


  // ==========================================================================
  // DESCRIPTION DE L'ARTICLE / PRESTATION
  // ==========================================================================

  // FE BT-153 — Nom précis du bien ou service.
  //
  // Exemples :
  // "Pose d'un chauffe-eau"
  // "Tube cuivre Ø22"
  title String

  // FE BT-154 — Description détaillée du bien/service.
  description String?

  // FE BT-155 — Référence article attribuée par le vendeur.
  //
  // C'est ici que peut être snapshotée la référence CatalogItem.
  sellerItemIdentifier String?

  // FE BT-156 — Référence article attribuée par l'acheteur.
  buyerItemIdentifier String?

  // FE BT-157 — Identifiant standardisé du produit.
  //
  // Exemple : GTIN/EAN.
  standardItemIdentifier String?

  // Attribut de scheme associé à BT-157.
  // Exemple possible : scheme correspondant au GTIN.
  standardItemIdentifierScheme String?

  // FE BT-159 — Pays d'origine du produit, ISO 3166-1 alpha-2.
  countryOfOriginCode String?


  // ==========================================================================
  // SOUS-BLOCS
  // ==========================================================================

  // FE BG-27 / BG-28 — Remises et charges de ligne.
  adjustments InvoiceItemAdjustment[]


  // ==========================================================================
  // CONTRAINTES
  // ==========================================================================

  @@unique([invoiceId, position])
  @@unique([invoiceId, lineIdentifier])
  @@index([invoiceId])
}

// ============================================================================
// REMISE OU CHARGE
// ============================================================================
//
// Même enum Workermate pour :
// - InvoiceAdjustment
// - InvoiceItemAdjustment
//
// Le mapper choisit ensuite le bloc normalisé correspondant.
//
enum InvoiceAdjustmentType {
  ALLOWANCE
  CHARGE
}

model InvoiceItemAdjustment {
  // WM — Identifiant technique.
  id String @id @default(cuid())

  invoiceItemId String
  invoiceItem InvoiceItem @relation(fields: [invoiceItemId],references: [id],onDelete: Cascade)

  // WM — Ordre d'affichage.
  position Int @default(0)

  // WM — Détermine quel groupe FE utiliser :
  //
  // ALLOWANCE -> BG-27
  // CHARGE    -> BG-28
  type InvoiceAdjustmentType


  // ==========================================================================
  // MONTANT
  // ==========================================================================

  // FE :
  //
  // ALLOWANCE -> BT-136
  // CHARGE    -> BT-141
  //
  // Montant HT de la remise/charge.
  amount Decimal @db.Decimal(19, 2)

  // FE :
  //
  // ALLOWANCE -> BT-137
  // CHARGE    -> BT-142
  //
  // Base servant au calcul.
  baseAmount Decimal? @db.Decimal(19, 2)

  // FE :
  //
  // ALLOWANCE -> BT-138
  // CHARGE    -> BT-143
  //
  // Pourcentage appliqué à baseAmount.
  percentage Decimal? @db.Decimal(9, 6)


  // ==========================================================================
  // MOTIF
  // ==========================================================================

  // FE :
  //
  // ALLOWANCE -> BT-139
  // CHARGE    -> BT-144
  //
  // Motif en texte libre.
  reason String?

  // FE :
  //
  // ALLOWANCE -> BT-140
  // CHARGE    -> BT-145
  //
  // Motif codifié.
  reasonCode String?

  @@unique([invoiceItemId, position])
  @@index([invoiceItemId])
}

// ============================================================================
// CATÉGORIE TVA
// ============================================================================
//
// Mapping facture électronique française :
//
// STANDARD                   -> S
// EXEMPT                     -> E
// REVERSE_CHARGE             -> AE
// INTRA_COMMUNITY_SUPPLY     -> K
// EXPORT                     -> G
// OUTSIDE_SCOPE              -> O
// ZERO                       -> Z
//
// Utilisé notamment pour :
// - BT-95  : TVA d'une remise au niveau document
// - BT-102 : TVA d'une charge au niveau document
// - BT-118 : ventilation TVA
// - BT-151 : TVA d'une ligne
//
enum VatCategory {
  STANDARD
  EXEMPT
  REVERSE_CHARGE
  INTRA_COMMUNITY_SUPPLY
  EXPORT
  OUTSIDE_SCOPE
  ZERO
}

model InvoiceVatBreakdown {
  // WM — Identifiant technique.
  id String @id @default(cuid())

  invoiceId String
  invoice Invoice @relation(fields: [invoiceId],references: [id],onDelete: Cascade)

  // ==========================================================================
  // VENTILATION TVA — BG-23
  // ==========================================================================

  // FE BT-116 — Base d'imposition HT de cette catégorie/taux.
  //
  // Elle inclut les lignes concernées ainsi que les charges/remises
  // documentaires correspondant à cette même catégorie/taux.
  taxableAmount Decimal @db.Decimal(19, 2)

  // FE BT-117 — Montant de TVA correspondant.
  vatAmount Decimal @db.Decimal(19, 2)

  // FE BT-118 — Code de catégorie TVA.
  vatCategory VatCategory

  // FE BT-119 — Taux de TVA.
  //
  // Peut être absent dans certains cas particuliers,
  // notamment OUTSIDE_SCOPE.
  vatRate Decimal? @db.Decimal(5, 2)

  // FE BT-120 — Motif d'exemption en texte.
  exemptionReason String?

  // FE BT-121 — Code normalisé du motif d'exemption.
  //
  // Exemple français :
  // VATEX-FR-FRANCHISE
  exemptionReasonCode String?

  @@index([invoiceId])
  @@index([invoiceId, vatCategory, vatRate])
}
// ============================================================================
// FACTURATION RÉCURRENTE — ENUMS
// ============================================================================

enum RecurringInvoiceStatus {
  // La récurrence est active et peut générer de nouvelles factures.
  ACTIVE

  // Suspendue temporairement.
  // nextOccurrenceDate est conservée afin de pouvoir reprendre.
  PAUSED

  // La série est définitivement terminée.
  ENDED
}


enum RecurrenceUnit {
  DAY
  WEEK
  MONTH
  YEAR
}


enum RecurringInvoiceGenerationMode {
  // Crée une Invoice en DRAFT.
  //
  // Mode recommandé / exposé en V1.
  DRAFT

  // Génère et émet automatiquement la facture.
  //
  // Le modèle peut être prêt dès maintenant,
  // même si cette option n'est pas encore exposée dans l'interface V1.
  AUTO_ISSUE
}


enum RecurringInvoiceBillingPeriodMode {
  // Aucune période de facturation automatiquement renseignée.
  NONE

  // La facture concerne la période correspondant à l'occurrence.
  //
  // Exemple avec une récurrence mensuelle :
  // occurrence 01/10/2026
  // -> 01/10/2026 au 31/10/2026.
  CURRENT_PERIOD

  // La facture concerne la période précédant l'occurrence.
  //
  // Exemple :
  // occurrence 01/10/2026
  // -> 01/09/2026 au 30/09/2026.
  PREVIOUS_PERIOD
}


enum RecurringInvoiceSupplyDateMode {
  // Ne renseigne pas automatiquement Invoice.supplyDate.
  NONE

  // Utilise la date de l'occurrence.
  OCCURRENCE_DATE

  // Utilise le début de la période calculée.
  PERIOD_START

  // Utilise la fin de la période calculée.
  PERIOD_END
}


// ============================================================================
// FACTURATION RÉCURRENTE
// ============================================================================

model RecurringInvoice {
  // ==========================================================================
  // IDENTITÉ WORKERMATE
  // ==========================================================================

  id String @id @default(cuid())

  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Utilisateur ayant créé la récurrence.
  createdById String?
  createdBy User? @relation("RecurringInvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)


  // ==========================================================================
  // CLIENT / CONTEXTE MÉTIER
  // ==========================================================================

  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Une facturation récurrente peut éventuellement appartenir
  // à une affaire / un contrat suivi dans un Project.
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Facultatif.
  //
  // À utiliser seulement lorsque toutes les occurrences concernent
  // réellement le même WorkOrder.
  workOrderId String?
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)


  // ==========================================================================
  // IDENTIFICATION
  // ==========================================================================

  // Nom interne permettant à l'artisan d'identifier la récurrence.
  //
  // Exemple :
  // "Entretien mensuel Restaurant Dupont"
  // "Maintenance annuelle chaudière Martin"
  name String

  status RecurringInvoiceStatus @default(ACTIVE)


  // ==========================================================================
  // RÈGLE DE RÉCURRENCE
  // ==========================================================================

  // DAY / WEEK / MONTH / YEAR.
  recurrenceUnit RecurrenceUnit

  // Nombre d'unités entre deux occurrences.
  //
  // Exemples :
  //
  // MONTH + 1 -> tous les mois
  // MONTH + 3 -> tous les trimestres
  // WEEK  + 2 -> toutes les deux semaines
  interval Int @default(1)

  // Première occurrence de la série.
  //
  // Sert également d'ancre de calendrier.
  startDate DateTime @db.Date

  // Prochaine occurrence devant être traitée.
  //
  // Nullable lorsque la récurrence est définitivement terminée.
  nextOccurrenceDate DateTime? @db.Date

  // Dernière occurrence ayant réellement généré une facture.
  //
  // Utile pour l'historique, le scheduler et le diagnostic.
  lastOccurrenceDate DateTime? @db.Date

  // Date maximale autorisée pour une occurrence.
  //
  // Null = pas de date de fin.
  endDate DateTime? @db.Date

  // Nombre maximum de factures à générer.
  //
  // Null = pas de limite par nombre.
  maxOccurrences Int?

  // Nombre de factures effectivement générées avec succès.
  generatedCount Int @default(0)


  // ==========================================================================
  // MODE DE GÉNÉRATION
  // ==========================================================================

  generationMode RecurringInvoiceGenerationMode @default(DRAFT)


  // ==========================================================================
  // CADRE DE FACTURATION
  // ==========================================================================

  // Catégorie de l'opération des futures factures.
  operationCategory InvoiceOperationCategory

  // Null peut signifier :
  // utiliser le régime configuré pour l'entreprise au moment
  // de la génération.
  vatAccountingMode VatAccountingMode?

  // Devise des futures factures.
  currency String @default("EUR")

  // Principalement utile lorsque la facture utilise une devise différente
  // de la devise comptable.
  accountingCurrency String?


  // ==========================================================================
  // RÉFÉRENCES COMMERCIALES
  // ==========================================================================

  // Référence acheteur stable sur le contrat / la récurrence.
  buyerReference String?

  // Référence projet explicitement transmise sur les factures.
  //
  // Si null, le backend peut éventuellement la déduire du Project lié.
  projectReference String?

  contractReference String?

  purchaseOrderReference String?

  salesOrderReference String?


  // ==========================================================================
  // PÉRIODE FACTURÉE / DATE DE PRESTATION
  // ==========================================================================

  // Règle utilisée pour générer :
  //
  // Invoice.billingPeriodStart
  // Invoice.billingPeriodEnd
  billingPeriodMode RecurringInvoiceBillingPeriodMode @default(NONE)

  // Règle utilisée pour générer Invoice.supplyDate.
  supplyDateMode RecurringInvoiceSupplyDateMode @default(NONE)


  // ==========================================================================
  // CONDITIONS DE PAIEMENT
  // ==========================================================================

  // Nombre de jours utilisé pour déterminer l'échéance.
  //
  // null :
  // utiliser la valeur par défaut de l'entreprise.
  dueInDays Int?

  // Override des conditions de paiement de l'entreprise.
  //
  // null :
  // utiliser les conditions actuellement configurées sur le Tenant.
  paymentTerms String?

  // Override du moyen de paiement demandé.
  //
  // null :
  // utiliser le moyen de paiement par défaut de l'entreprise.
  paymentMeansCode String?

  paymentMeansText String?


  // ==========================================================================
  // COMPTE DE PAIEMENT
  // ==========================================================================

  // Compte bancaire explicitement imposé pour cette récurrence.
  //
  // null :
  // utiliser Tenant.defaultPaymentAccount au moment de la génération.
  paymentAccountId String?

  paymentAccount PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)

  // IMPORTANT :
  //
  // On ne stocke PAS ici :
  //
  // paymentIban
  // paymentAccountName
  // paymentBic
  //
  // Ces valeurs sont récupérées depuis PaymentAccount lors de la génération,
  // puis snapshotées dans Invoice.


  // ==========================================================================
  // CONTENU DES FUTURES FACTURES
  // ==========================================================================

  items RecurringInvoiceItem[]

  // Remises / charges globales qui seront copiées vers InvoiceAdjustment.
  adjustments RecurringInvoiceAdjustment[]

  // Notes destinées à apparaître sur les factures générées.
  notes RecurringInvoiceNote[]


  // ==========================================================================
  // NOTES INTERNES
  // ==========================================================================

  // Information uniquement destinée à Workermate.
  //
  // Ne doit pas automatiquement être copiée dans Invoice.internalNotes.
  internalNotes String?


  // ==========================================================================
  // FACTURES GÉNÉRÉES
  // ==========================================================================

  // Historique des vraies factures issues de cette récurrence.
  invoices Invoice[]


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================================
  // INDEX
  // ==========================================================================

  // Requête principale du scheduler :
  //
  // WHERE tenantId = ...
  // AND status = ACTIVE
  // AND nextOccurrenceDate <= aujourd'hui
  @@index([tenantId, status, nextOccurrenceDate])

  @@index([customerId])
  @@index([projectId])
  @@index([workOrderId])
  @@index([paymentAccountId])
}

// ============================================================================
// PÉRIODE D'UNE LIGNE DE FACTURATION RÉCURRENTE
// ============================================================================

enum RecurringInvoiceItemBillingPeriodMode {
  // Reprend la période définie au niveau de RecurringInvoice.
  INHERIT

  // Aucune période spécifique sur la ligne.
  NONE

  // Période correspondant à l'occurrence courante.
  //
  // Exemple pour une récurrence mensuelle générée le 01/10 :
  // 01/10 -> 31/10
  CURRENT_PERIOD

  // Période précédant l'occurrence.
  //
  // Exemple pour une facture générée le 01/10 :
  // 01/09 -> 30/09
  PREVIOUS_PERIOD
}


// ============================================================================
// LIGNE D'UNE FACTURATION RÉCURRENTE
// ============================================================================

model RecurringInvoiceItem {
  // ==========================================================================
  // IDENTITÉ WORKERMATE
  // ==========================================================================

  id String @id @default(cuid())

  recurringInvoiceId String
  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)


  // ==========================================================================
  // IDENTIFICATION DE LA LIGNE
  // ==========================================================================

  // Ordre utilisé dans le modèle de facture récurrente.
  //
  // Lors de la génération :
  //
  // position = 0 -> InvoiceItem.lineIdentifier = "1"
  // position = 1 -> InvoiceItem.lineIdentifier = "2"
  // etc.
  position Int

  // Notes qui seront copiées dans chaque InvoiceItem généré.
  notes String[] @default([])

  // Identifiant métier de l'objet facturé lorsqu'il est stable
  // d'une occurrence à l'autre.
  //
  // Exemple :
  // compteur, équipement sous contrat, abonnement...
  objectIdentifier String?


  // ==========================================================================
  // TYPE WORKERMATE
  // ==========================================================================

  type LineItemType


  // ==========================================================================
  // QUANTITÉ
  // ==========================================================================

  // Quantité utilisée comme valeur par défaut à chaque occurrence.
  quantity Decimal @default(1) @db.Decimal(19, 6)

  // Code d'unité normalisé.
  //
  // Exemples :
  // C62 = unité
  // HUR = heure
  // KGM = kilogramme
  // MTR = mètre
  unitCode String

  // Libellé utilisateur.
  //
  // Exemple :
  // "unité", "heure", "kg", "m".
  unitLabel String?


  // ==========================================================================
  // RÉFÉRENCES ACHETEUR
  // ==========================================================================

  // Référence de ligne de bon de commande utilisée pour les futures factures.
  //
  // À utiliser uniquement si cette référence est stable sur la récurrence.
  purchaseOrderLineReference String?

  // Référence comptable acheteur stable utilisée pour cette ligne.
  buyerAccountingReference String?


  // ==========================================================================
  // PÉRIODE DE FACTURATION
  // ==========================================================================

  // Contrairement à InvoiceItem.billingPeriodStart / billingPeriodEnd,
  // on ne stocke pas ici de dates historiques figées.
  //
  // Le générateur déterminera les dates réelles lors de chaque occurrence.
  billingPeriodMode RecurringInvoiceItemBillingPeriodMode @default(INHERIT)


  // ==========================================================================
  // PRIX
  // ==========================================================================

  // Prix unitaire NET HT utilisé pour les prochaines occurrences.
  unitPrice Decimal @db.Decimal(19, 6)

  // Rabais sur le prix unitaire brut permettant d'obtenir unitPrice.
  //
  // Même sémantique que InvoiceItem.unitPriceDiscountAmount.
  unitPriceDiscountAmount Decimal? @db.Decimal(19, 6)

  // Prix unitaire brut avant rabais.
  grossUnitPrice Decimal? @db.Decimal(19, 6)

  // Quantité de base à laquelle s'applique le prix.
  //
  // Exemple :
  // 20 € pour 100 vis.
  baseQuantity Decimal @default(1) @db.Decimal(19, 6)

  baseQuantityUnitCode String?


  // ==========================================================================
  // TVA
  // ==========================================================================

  vatCategory VatCategory

  vatRate Decimal? @db.Decimal(5, 2)

  // Motifs qui seront copiés sur l'InvoiceItem généré lorsqu'ils sont
  // applicables à cette ligne récurrente.
  vatExemptionReason String?

  vatExemptionReasonCode String?


  // ==========================================================================
  // DESCRIPTION DE L'ARTICLE / PRESTATION
  // ==========================================================================

  title String

  description String?

  // Référence article vendeur utilisée comme snapshot dans les futures factures.
  //
  // Elle peut provenir initialement d'un CatalogItem mais devient indépendante.
  sellerItemIdentifier String?

  // Référence article attribuée par l'acheteur.
  buyerItemIdentifier String?

  // Identifiant standardisé du produit.
  //
  // Exemple : GTIN/EAN.
  standardItemIdentifier String?

  standardItemIdentifierScheme String?

  // Pays d'origine ISO 3166-1 alpha-2.
  countryOfOriginCode String?


  // ==========================================================================
  // SOUS-BLOCS
  // ==========================================================================

  // Remises et charges devant être reproduites sur chaque InvoiceItem généré.
  adjustments RecurringInvoiceItemAdjustment[]


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================================
  // CONTRAINTES
  // ==========================================================================

  @@unique([recurringInvoiceId, position])
  @@index([recurringInvoiceId])
}

// ============================================================================
// RÈGLE DE CALCUL D'UNE REMISE / CHARGE RÉCURRENTE
// ============================================================================

enum RecurringAdjustmentCalculationMode {
  // Montant fixe.
  //
  // Exemple :
  // remise de 50 € HT.
  FIXED_AMOUNT

  // Pourcentage calculé lors de la génération de la facture.
  //
  // Exemple :
  // remise de 10 %.
  PERCENTAGE
}


// ============================================================================
// AFFECTATION TVA D'UNE REMISE / CHARGE GLOBALE RÉCURRENTE
// ============================================================================

enum RecurringInvoiceAdjustmentVatMode {
  // Workermate répartit automatiquement la remise / charge
  // entre les différents groupes TVA présents sur la facture.
  //
  // Exemple :
  //
  // lignes :
  // - 1 000 € à 20 %
  // -   500 € à 10 %
  //
  // remise globale : 10 %
  //
  // génération :
  // - InvoiceAdjustment 100 € / STANDARD / 20 %
  // - InvoiceAdjustment  50 € / STANDARD / 10 %
  AUTO

  // La remise / charge concerne explicitement
  // une catégorie / un taux TVA précis.
  SPECIFIC
}

model RecurringInvoiceAdjustment {
  // ==========================================================================
  // IDENTITÉ
  // ==========================================================================

  id String @id @default(cuid())

  recurringInvoiceId String

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // IDENTIFICATION
  // ==========================================================================

  // Ordre d'application / affichage.
  position Int @default(0)

  // ALLOWANCE = remise
  // CHARGE    = charge / frais
  type InvoiceAdjustmentType


  // ==========================================================================
  // MODE DE CALCUL
  // ==========================================================================

  calculationMode RecurringAdjustmentCalculationMode

  // Utilisé uniquement lorsque :
  //
  // calculationMode = FIXED_AMOUNT
  //
  // Montant HT de la remise / charge.
  amount Decimal? @db.Decimal(19, 2)

  // Utilisé uniquement lorsque :
  //
  // calculationMode = PERCENTAGE
  //
  // Exemple :
  // 10.000000 = 10 %
  percentage Decimal? @db.Decimal(9, 6)


  // ==========================================================================
  // AFFECTATION TVA
  // ==========================================================================

  // AUTO :
  //
  // Workermate répartit la remise / charge entre les différents
  // groupes TVA présents lors de la génération.
  //
  // SPECIFIC :
  //
  // vatCategory doit être renseigné.
  vatMode RecurringInvoiceAdjustmentVatMode @default(AUTO)

  // Utilisé lorsque vatMode = SPECIFIC.
  vatCategory VatCategory?

  // Taux correspondant lorsque nécessaire.
  //
  // Exemple :
  //
  // STANDARD + 20
  // STANDARD + 10
  //
  // Peut rester null pour certaines catégories TVA.
  vatRate Decimal? @db.Decimal(5, 2)


  // ==========================================================================
  // MOTIF
  // ==========================================================================

  // Motif qui sera snapshoté sur les InvoiceAdjustment générés.
  reason String?

  // Code normalisé éventuel du motif.
  reasonCode String?


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // ==========================================================================
  // CONTRAINTES
  // ==========================================================================

  @@unique([recurringInvoiceId, position])
  @@index([recurringInvoiceId])
}

model RecurringInvoiceItemAdjustment {
