model CatalogItem {
  id String @id @default(cuid())


  // ==========================================================================
  // PROPRIÉTAIRE
  // ==========================================================================

  tenantId String

  tenant Tenant @relation(fields: [tenantId],references: [id],onDelete: Cascade)


  // ==========================================================================
  // IDENTIFICATION
  // ==========================================================================

  type LineItemType

  // Référence interne de l'article / prestation.
  //
  // Exemples :
  // MAT-CUIVRE-22
  // MO-PLOMBERIE
  // DEP-001
  //
  // Peut être copiée dans sellerItemIdentifier
  // sur QuoteItem / InvoiceItem.
  reference String?

  title String

  description String?

  // Permet de désactiver une entrée sans la supprimer,
  // afin de préserver l'historique et les relations existantes.
  isActive Boolean @default(true)


  // ==========================================================================
  // QUANTITÉ / UNITÉ PAR DÉFAUT
  // ==========================================================================

  // Quantité proposée par défaut lors de l'ajout dans :
  // - un devis,
  // - un WorkOrder,
  // - éventuellement un Purchase.
  //
  // Exemples :
  // 1
  // 0.125 m³
  // 1.5 heure
  defaultQuantity Decimal @default(1) @db.Decimal(19, 6)

  // Unité de référence de l'article.
  //
  // Pour un article suivi en stock, il s'agit également
  // de son unité de stock.
  //
  // Exemples :
  // C62 = unité
  // HUR = heure
  // KGM = kilogramme
  // MTR = mètre
  unitCode String

  // Libellé humain :
  // unité, heure, kg, m...
  unitLabel String?


  // ==========================================================================
  // PRIX DE VENTE
  // ==========================================================================

  // Prix de vente NET HT proposé par défaut.
  //
  // Nullable car un CatalogItem peut être créé automatiquement
  // depuis un achat avant qu'un prix de vente ne soit défini.
  //
  // Exemple :
  // achat de câble -> CatalogItem créé avec unitCost connu,
  // mais unitPrice encore null.
  //
  // Peut être copié vers :
  // QuoteItem.unitPrice
  // InvoiceItem.unitPrice
  //
  // Le frontend / backend devra demander un prix avant de créer
  // une ligne commerciale qui exige unitPrice.
  unitPrice Decimal? @db.Decimal(19, 6)

  // Quantité à laquelle unitPrice correspond.
  //
  // Exemple :
  //
  // 25 € pour 100 vis
  //
  // unitPrice     = 25
  // baseQuantity  = 100
  //
  // Peut devenir InvoiceItem.baseQuantity.
  baseQuantity Decimal @default(1) @db.Decimal(19, 6)

  // Unité correspondant à baseQuantity.
  //
  // Peut devenir InvoiceItem.baseQuantityUnitCode.
  baseQuantityUnitCode String?


  // ==========================================================================
  // TVA DE VENTE
  // ==========================================================================

  // Catégorie TVA proposée par défaut lors de la création
  // d'une ligne commerciale.
  //
  // Elle reste une valeur par défaut :
  // QuoteItem / InvoiceItem deviennent ensuite indépendants.
  vatCategory VatCategory @default(STANDARD)

  // Taux de TVA de vente proposé par défaut.
  //
  // Nullable car certaines catégories TVA n'utilisent
  // pas de taux classique.
  vatRate Decimal? @db.Decimal(5, 2)


  // ==========================================================================
  // COÛT / RENTABILITÉ
  // ==========================================================================

  // Coût économique de référence pour UNE unité `unitCode`.
  //
  // IMPORTANT :
  // contrairement à unitPrice, il ne dépend pas de baseQuantity.
  //
  // Exemple :
  //
  // unitCode = MTR
  // unitCost = 4.50
  //
  // signifie :
  // 4,50 € de coût économique par mètre.
  //
  // Il s'agit du coût hors TVA récupérable.
  // Il peut donc inclure de la TVA non déductible.
  //
  // Exemple entreprise récupérant la TVA :
  //
  // achat :
  // 4 € HT + 0,80 € TVA déductible
  // -> unitCost = 4 €
  //
  // Exemple TVA non récupérable :
  //
  // 4 € HT + 0,80 € TVA
  // -> unitCost = 4,80 €
  //
  // Pour un article suivi en stock, cette valeur peut être
  // automatiquement synchronisée avec :
  //
  // StockItem.averageUnitCost.
  //
  // Pour une prestation ou un article non suivi en stock,
  // elle reste un coût estimatif saisi manuellement.
  unitCost Decimal? @db.Decimal(19, 6)

  // Taux de TVA généralement constaté lors de l'achat.
  //
  // Purement indicatif :
  // ce n'est PAS une donnée fiscale définitive.
  //
  // Les vraies données viennent de :
  // PurchaseItem
  // puis, lorsqu'elle existe, SupplierInvoice / SupplierInvoiceItem.
  //
  // Ce champ peut servir à préremplir une estimation d'achat.
  purchaseVatRate Decimal? @db.Decimal(5, 2)


  // ==========================================================================
  // STOCK
  // ==========================================================================

  // Indique si cet article doit être suivi physiquement en stock.
  //
  // Exemples :
  //
  // câble électrique       -> true
  // raccord                -> true
  // sac de ciment          -> true
  //
  // main-d'œuvre           -> false
  // location mini-pelle    -> false
  // déplacement            -> false
  trackStock Boolean @default(false)

  // État courant du stock.
  //
  // Nullable lorsque l'article n'est pas suivi en stock.
  stockItem StockItem?


  // ==========================================================================
  // ACHATS
  // ==========================================================================

  // Historique des lignes d'achat opérationnelles ayant été
  // rattachées à cet article.
  //
  // PurchaseItem reste un snapshot indépendant :
  // modifier CatalogItem ne modifie jamais un achat passé.
  purchaseItems PurchaseItem[]


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt


  // ==========================================================================
  // CONTRAINTES / INDEXES
  // ==========================================================================

  @@unique([tenantId, reference])

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, trackStock])
}

