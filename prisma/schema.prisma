model Quote {
  id String @id @default(cuid())

  // ==========================================================================
  // RELATIONS WORKERMATE
  // ==========================================================================

  tenantId String
  tenant Tenant @relation(fields: [tenantId],references: [id],onDelete: Restrict)

  customerId String
  customer Customer @relation(fields: [customerId],references: [id],onDelete: Restrict)

  workOrderId String?
  workOrder WorkOrder? @relation(fields: [workOrderId],references: [id],onDelete: SetNull)

  projectId String?
  project Project? @relation(fields: [projectId],references: [id],onDelete: SetNull)


  // ==========================================================================
  // IDENTIFICATION DU DEVIS
  // ==========================================================================

  // Numéro métier du devis.
  // Contrairement aux factures, pas besoin d'une séquence fiscale
  // chronologique continue, mais le numéro doit être unique dans le tenant.
  number String

  title String

  // Nature / périmètre détaillé des travaux proposés.
  description String?

  issueDate DateTime
  validUntil DateTime?

  status QuoteStatus @default(DRAFT)

  // Historique métier utile notamment pour devis accepté par acompte.
  acceptedAt DateTime?
  rejectedAt DateTime?


  // ==========================================================================
  // RÉFÉRENCES MÉTIER — SNAPSHOTS
  // ==========================================================================

  projectReference String?
  projectTitle String?

  workOrderReference String?
  workOrderTitle String?


  // ==========================================================================
  // SNAPSHOT ENTREPRISE
  // ==========================================================================

  tenantLegalName String
  tenantTradingName String?

  tenantLegalForm String?
  tenantShareCapital Decimal? @db.Decimal(19, 2)
  tenantRegistrationMention String?

  tenantSirenNumber String
  tenantSiretNumber String?
  tenantVatNumber String?

  tenantStreet1 String
  tenantStreet2 String?
  tenantPostalCode String
  tenantCity String
  tenantCountryCode String @default("FR")

  tenantEmail String?
  tenantPhoneNumber String?

  // Peut être utile notamment lorsqu'un acompte doit être versé.
  tenantIban String?
  tenantBic String?


  // ==========================================================================
  // ASSURANCE PROFESSIONNELLE — SNAPSHOT
  // ==========================================================================

  // À renseigner uniquement pour les activités concernées.
  tenantInsurancePolicyNumber String?
  tenantInsurerName String?
  tenantInsurerAddress String?
  tenantInsuranceGeographicCoverage String?


  // ==========================================================================
  // SNAPSHOT CLIENT
  // ==========================================================================

  // Nom exact devant apparaître sur le document.
  // Particulier : "Jean Dupont"
  // Société     : "Dupont Électricité SARL"
  customerName String

  customerFirstName String?
  customerLastName String?
  customerCompany String?

  customerSirenNumber String?
  customerSiretNumber String?
  customerVatNumber String?

  customerStreet1 String
  customerStreet2 String?
  customerPostalCode String
  customerCity String
  customerCountryCode String @default("FR")

  customerEmail String?
  customerPhoneNumber String?


  // ==========================================================================
  // LIEU / PÉRIODE DES TRAVAUX — SNAPSHOT
  // ==========================================================================

  workOrderStartDate DateTime?
  workOrderEndDate DateTime?

  // On peut conserver la relation pour naviguer dans Workermate...
  workOrderAddressId String?
  workOrderAddress Address? @relation(fields: [workOrderAddressId],references: [id],onDelete: SetNull)

  // ...mais le devis émis doit conserver son propre snapshot.
  workOrderStreet1 String?
  workOrderStreet2 String?
  workOrderPostalCode String?
  workOrderCity String?
  workOrderCountryCode String?


  // ==========================================================================
  // DEVIS PAYANT / GRATUIT
  // ==========================================================================

  // 0 = devis gratuit.
  // Montant facturé pour l'établissement du devis si celui-ci est payant.
  quotePreparationFee Decimal @default(0) @db.Decimal(19, 2)


  // ==========================================================================
  // MONTANTS
  // ==========================================================================

  currency String @default("EUR")

  // Somme des montants nets HT des QuoteItem.
  lineNetTotal Decimal @db.Decimal(19, 2)

  // Remises au niveau global du devis.
  allowanceTotal Decimal @default(0) @db.Decimal(19, 2)

  // Frais / charges au niveau global du devis.
  chargeTotal Decimal @default(0) @db.Decimal(19, 2)

  // lineNetTotal - allowanceTotal + chargeTotal
  taxExclusiveAmount Decimal @db.Decimal(19, 2)

  vatAmount Decimal @db.Decimal(19, 2)

  taxInclusiveAmount Decimal @db.Decimal(19, 2)


  // ==========================================================================
  // ACOMPTE DEMANDÉ
  // ==========================================================================

  // Exemple : 30.00 signifie 30 %.
  // Nullable pour permettre un acompte fixé directement en euros.
  depositRate Decimal? @db.Decimal(7, 4)

  // Snapshot du montant effectivement demandé.
  //
  // Exemple :
  // depositRate   = 30
  // depositAmount = 3 600 €
  //
  // Important : ce n'est PAS un paiement reçu.
  depositAmount Decimal? @db.Decimal(19, 2)


  // ==========================================================================
  // CONDITIONS / MENTIONS
  // ==========================================================================

  paymentTerms String?

  legalMentions String?

  // Conditions d'acceptation, limites de prestation, exclusions, etc.
  termsAndConditions String?

  notes String?

  customerKeepsReplacedParts Boolean?


  // ==========================================================================
  // SOUS-MODÈLES
  // ==========================================================================

  items QuoteItem[]

  // Remises / charges globales.
  adjustments QuoteAdjustment[]

  // Ventilation de TVA figée sur le devis.
  vatBreakdowns QuoteVatBreakdown[]

  invoices Invoice[]


  // ==========================================================================
  // DOCUMENT
  // ==========================================================================

  pdfFileId String?


  // ==========================================================================
  // MÉTADONNÉES
  // ==========================================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, number])

  @@index([tenantId, issueDate])
  @@index([tenantId, status])
  @@index([customerId, issueDate])
  @@index([projectId])
  @@index([workOrderId])
}

